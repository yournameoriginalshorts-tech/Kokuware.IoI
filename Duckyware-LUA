local KEY_FILE = "duckyware_key.dat"
local function hasSavedKey()
    local ok, content = pcall(readfile, KEY_FILE)
    return ok and type(content) == "string" and (content == getRealKey() or content == ALT_KEY)
end
local function saveKey(k) pcall(writefile, KEY_FILE, k) end

local function askKey()
    if hasSavedKey() then return true end
    if getgenv and getgenv().Duckyware_Key ~= nil then
        local gk = getgenv().Duckyware_Key
        local ok = (gk == getRealKey() or gk == ALT_KEY)
        if ok then saveKey(gk) end
        return ok
    end
    local gui   = newGui("KeyPrompt")
    local frame = makePanel(gui, UDim2.fromOffset(280, 170), UDim2.new(0.5, 0, 0.4, 0), Vector2.new(0.5, 0))
    makeLabel(frame, "Key Authentication", UDim2.new(1, -30, 0, 18), UDim2.new(0.5, 0, 0, 44))
    local box    = makeBox(frame, UDim2.fromOffset(220, 34), UDim2.new(0.5, 0, 0, 72), "", "key...")
    local btn    = makeButton(frame, "Submit", UDim2.fromOffset(220, 32), UDim2.new(0.5, 0, 0, 118), true)
    local status = makeLabel(frame, "", UDim2.new(1, -20, 0, 18), UDim2.new(0.5, 0, 0, 152), 11)
    local ok, done = false, false
    local function try()
        if box.Text == getRealKey() or box.Text == ALT_KEY then
            saveKey(box.Text); ok, done = true, true
        else
            status.Text = "Invalid key"; box.Text = ""
        end
    end
    btn.MouseButton1Click:Connect(try)
    box.FocusLost:Connect(function(enter) if enter then try() end end)
    repeat task.wait() until done
    gui:Destroy()
    return ok
end

