    ----------------------------------------------------------------
    -- .R6 guard (stays on once enabled, even across rejoins):
    -- when someone says "oof o/a/others/all", "oof <this bot>" or "reset <this bot>",
    -- hold the Arkenstone out (if we have it) and say ;R6 within ~0.1s.
    -- .R6 = on, .R6 off = off, .R6 now = fire once
    ----------------------------------------------------------------
    local R6_FILE = "Duckyware_R6.txt"
    local r6On, r6Last = false, 0
    pcall(function()
        if isfile and isfile(R6_FILE) and readfile(R6_FILE) == "1" then r6On = true end   -- stays active across rejoins
    end)
    local function setR6(v)
        r6On = v
        pcall(function() if writefile then writefile(R6_FILE, v and "1" or "0") end end)
        addLogEntry("[R6] guard " .. (v and "ON" or "OFF"))
    end
    local function holdStone()
        local char = LocalPlayer.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("Tool") and c.Name:lower():find("arkenstone", 1, true) then return end   -- already held
        end
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if not bp then return end
        for _, c in ipairs(bp:GetChildren()) do
            if c:IsA("Tool") and c.Name:lower():find("arkenstone", 1, true) then
                pcall(function() hum:EquipTool(c) end)
                return
            end
        end
    end
    local function fireR6()
        holdStone()            -- hold it out first (if we have it)
        task.wait(0.05)
        sendRaw(";R6")         -- total well under 0.2s after the trigger message
    end
    local function nameMatch(arg)
        if #arg < 3 then return false end
        return LocalPlayer.Name:lower():sub(1, #arg) == arg or LocalPlayer.DisplayName:lower():sub(1, #arg) == arg
    end
    _G.DuckywareR6Hook = function(sender, text)
        if not r6On or not sender or sender == LocalPlayer then return end
        local cmd, arg = text:lower():match("^[;%.:!]?%s*(%a+)%s+(%S+)")
        if not cmd then return end
        local hit = false
        if cmd == "oof" then
            hit = arg == "o" or arg == "a" or arg == "others" or arg == "all" or nameMatch(arg)
        elseif cmd == "reset" then
            hit = nameMatch(arg)
        end
        if not hit then return end
        local now = os.clock()
        if now - r6Last < 0.5 then return end      -- same message arrives from several sources
        r6Last = now
        addLogEntry("[R6] " .. sender.Name .. " said '" .. text .. "' -> ;R6")
        task.spawn(fireR6)
    end

