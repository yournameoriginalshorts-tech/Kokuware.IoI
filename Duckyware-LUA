        local isDragging, startCF, rel = false, CFrame.new(), {}
        local function beginDrag()
            isDragging=true; workspace.CurrentCamera.CameraType=Enum.CameraType.Scriptable
            startCF=centerPart.CFrame; rel={}
            for _, child in pairs(visualFolder:GetChildren()) do
                if child:IsA("BasePart") and child~=centerPart then rel[child]=startCF:ToObjectSpace(child.CFrame) end
            end
        end
        local function endDrag()
            isDragging=false; workspace.CurrentCamera.CameraType=Enum.CameraType.Custom
        end
        handles.MouseButton1Down:Connect(beginDrag)
        handles.MouseDrag:Connect(function(face, distance)
            if not isDragging then return end
            local dirs={[Enum.NormalId.Right]=Vector3.new(1,0,0),[Enum.NormalId.Left]=Vector3.new(-1,0,0),
                [Enum.NormalId.Top]=Vector3.new(0,1,0),[Enum.NormalId.Bottom]=Vector3.new(0,-1,0),
                [Enum.NormalId.Front]=Vector3.new(0,0,-1),[Enum.NormalId.Back]=Vector3.new(0,0,1)}
            -- snap to whole 4-stud cells so the build stays on the grid
            local newCF = startCF + (dirs[face] or Vector3.zero)*(math.round(distance/4)*4)
            centerPart.CFrame=newCF
            for part,r in pairs(rel) do if part and part.Parent then part.CFrame=newCF*r end end
            buildCF=newCF
        end)
        handles.MouseButton1Up:Connect(endDrag)
        arcHandles.MouseButton1Down:Connect(beginDrag)
        arcHandles.MouseDrag:Connect(function(axis, angle)
            if not isDragging then return end
            local snap=math.rad(math.round(math.deg(angle)/90)*90)
            local newCF=startCF*CFrame.Angles(
                (axis==Enum.Axis.X) and snap or 0,
                (axis==Enum.Axis.Y) and snap or 0,
                (axis==Enum.Axis.Z) and snap or 0)
            centerPart.CFrame=newCF
            for part,r in pairs(rel) do if part and part.Parent then part.CFrame=newCF*r end end
            buildCF=newCF
        end)
        arcHandles.MouseButton1Up:Connect(endDrag)
    end

