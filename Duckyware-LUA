-- Main bot logic
----------------------------------------------------------------------
function main(allowedUsername, slotNumber)
    cleanupConnections()
    setUserFiles(allowedUsername)
    loadMessages()
    K.Build.stop()
    K.AntiGrief.stop()

    _G.KokuwareGen = (_G.KokuwareGen or 0) + 1
    local myGen = _G.KokuwareGen

    local ModUsers  = {}
    local Prefix    = "."
    local hasOwner  = allowedUsername ~= nil and allowedUsername ~= ""
    local ownerName = hasOwner and allowedUsername or ""
    K.getPrefix = function() return Prefix end

    local Inplace          = "inplace"
    local TeleportService  = game:GetService("TeleportService")

    local loopActive, loopMsg                = false, ""
    local adallActive, adallInterval, adallTarget = false, 1, ""
    local silentMode                         = false
    local hiding, hidePartObj                = false, nil
    local hidePos, returnPos                 = Vector3.new(0,5000,0), nil

    local followConnection, orbitConnection, formationConnection = nil, nil, nil
    local orbitAngle     = 0
    local movementPlatform, mapMovedUp, originalMapCFrames = nil, false, {}

    local ORBIT_DISTANCE, orbitSpeed     = 10, 1.5
    local LINE_SPACING, LINEUP_SPACING, STAR_SIZE = 7, 6, 10
    local totalBots    = loadSavedBots()
    local autoMatchMsg = "°"

    local function fixUsername(name) return (name:gsub("_",".")) end
    local function isOwnerName(name)
        return hasOwner and name:lower() == ownerName:lower()
    end
    local function isOwner(player)
        if K.Access.isBlacklisted(player) then return false end
        if not hasOwner then return true end
        return isOwnerName(player.Name)
    end
    local function isAllowed(player)
        if K.Access.isBlacklisted(player) then return false end
        if not hasOwner then return true end
        if isOwnerName(player.Name) then return true end
        if ModUsers[player.UserId] then return true end
        return false
    end
    K.AntiGrief.isProtected = function(p) return isOwnerName(p.Name) or ModUsers[p.UserId] == true end

    ----------------------------------------------------------------
    -- Chat sending (auto-splits anything over 110 characters)
    ----------------------------------------------------------------
    local MAX_LEN     = 110
    local CHUNK_DELAY = 1.2 -- raise to 1.5-2 if messages get dropped

    local function splitMessage(text, maxLen)
        local chunks, current = {}, ""
        for word in text:gmatch("%S+") do
            while #word > maxLen do
                if current ~= "" then table.insert(chunks, current); current = "" end
                table.insert(chunks, word:sub(1, maxLen))
                word = word:sub(maxLen + 1)
            end
            if current == "" then
                current = word
            elseif #current + 1 + #word <= maxLen then
                current = current .. " " .. word
            else
                table.insert(chunks, current)
                current = word
            end
        end
        if current ~= "" then table.insert(chunks, current) end
        return chunks
    end

    local function sendChat(msg)
        local text = silentMode and (msg:gsub("^;", "")) or msg
        if #text <= MAX_LEN then
            sendRaw(text)
            return
        end
        local chunks = splitMessage(text, MAX_LEN)
        for i, chunk in ipairs(chunks) do
            sendRaw(chunk)
            if i < #chunks then task.wait(CHUNK_DELAY) end
        end
    end
    keyboardSend = sendChat

    ----------------------------------------------------------------
    -- .R6 guard (stays on once enabled, even across rejoins)
    -- .R6 = on, .R6 off = off, .R6 now = fire once
    ----------------------------------------------------------------
    local R6_FILE = "Kokuware_R6.txt"
    local r6On, r6Last = false, 0
    pcall(function()
        if isfile and isfile(R6_FILE) and readfile(R6_FILE) == "1" then r6On = true end
    end)
    local function setR6(v)
        r6On = v
        pcall(function() if writefile then writefile(R6_FILE, v and "1" or "0") end end)
        addLogEntry("[R6] guard " .. (v and "ON" or "OFF"))
    end
    local function holdStone()
        local char = LocalPlayer.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("Tool") and c.Name:lower():find("arkenstone", 1, true) then return end
        end
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if not bp then return end
        for _, c in ipairs(bp:GetChildren()) do
            if c:IsA("Tool") and c.Name:lower():find("arkenstone", 1, true) then
                pcall(function() hum:EquipTool(c) end)
                return
            end
        end
    end
    local function fireR6()
        holdStone()
        task.wait(0.05)
        sendRaw(";R6")
    end
    local function nameMatch(arg)
        if #arg < 3 then return false end
        return LocalPlayer.Name:lower():sub(1, #arg) == arg or LocalPlayer.DisplayName:lower():sub(1, #arg) == arg
    end
    _G.KokuwareR6Hook = function(sender, text)
        if not r6On or not sender or sender == LocalPlayer then return end
        local cmd, arg = text:lower():match("^[;%.:!]?%s*(%a+)%s+(%S+)")
        if not cmd then return end
        local hit = false
        if cmd == "oof" then
            hit = arg == "o" or arg == "a" or arg == "others" or arg == "all" or nameMatch(arg)
        elseif cmd == "reset" then
            hit = nameMatch(arg)
