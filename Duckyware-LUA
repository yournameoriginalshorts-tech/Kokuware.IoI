local function hookRemote(remote)
    if not remote:IsA("RemoteEvent") then return end
    pcall(function()
        remote.OnClientEvent:Connect(function(...)
            local args = {...}
            local foundText
            for _, a in ipairs(args) do
                if type(a) == "string" then
                    local s = a:gsub("^%s+", ""):gsub("%s+$", "")
                    if s:sub(1, 1) == ";" then foundText = s; break end
                end
            end
            if not foundText then return end
            local sender
            for _, a in ipairs(args) do
                if typeof(a) == "Instance" and a:IsA("Player") then sender = a; break end
            end
            if not sender then
                for _, a in ipairs(args) do
                    if type(a) == "string" then
                        local l = a:lower()
                        for _, p in ipairs(Players:GetPlayers()) do
                            if p.Name:lower() == l or p.DisplayName:lower() == l then sender = p; break end
                        end
                    end
                    if sender then break end
                end
            end
            SpyOnMessage(sender, foundText, "?(remote)", "Remote")
        end)
    end)
end
for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do hookRemote(obj) end
ReplicatedStorage.DescendantAdded:Connect(hookRemote)

