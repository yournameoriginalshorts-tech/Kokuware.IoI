    local prevIncoming
    if type(getcallbackvalue) == "function" then
        local ok, v = pcall(getcallbackvalue, TextChatService, "OnIncomingMessage")
        if ok and type(v) == "function" then prevIncoming = v end
    end
    spyInfo.hooks.OnIncomingMessage = pcall(function()
