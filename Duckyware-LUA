    local function startFormation(target, formationType, follow, inplace)
        stopAllMovement()
        if inplace then createPlatform(); return end
        local flapping  = (formationType == "bodyguard")
        local structure = (formationType == "staircase" or formationType == "bridge")
        if follow or flapping or structure then createPlatform() end
        local function doTeleport()
            local myChar, targetChar = LocalPlayer.Character, target.Character
            if not (myChar and targetChar) then return end
            local myRoot    = myChar:FindFirstChild("HumanoidRootPart")
            local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
            if not (myRoot and targetRoot) then return end
            local look, right = targetRoot.CFrame.LookVector, targetRoot.CFrame.RightVector
            local pos, faceTarget = nil, false
            if formationType=="line" then
                pos = targetRoot.Position - look*3 + right*((slotNumber-(totalBots+1)/2)*LINE_SPACING)
            elseif formationType=="lineup" then
                pos = targetRoot.Position - look*(slotNumber*LINEUP_SPACING)
            elseif formationType=="circle" then
                pos, faceTarget = getCirclePosition(targetRoot,slotNumber,totalBots,ORBIT_DISTANCE), true
            elseif formationType=="star" then
                pos, faceTarget = getStarPosition(targetRoot,slotNumber,totalBots,STAR_SIZE), true
            elseif formationType=="wall" then
                -- shield in front of you, facing outward
                local cols = math.ceil(math.sqrt(totalBots)); local rows = math.ceil(totalBots/cols)
                local col = ((slotNumber-1)%cols)-(cols-1)/2
                local row = math.floor((slotNumber-1)/cols)-(rows-1)/2
                pos = targetRoot.Position + look*5 + right*(col*3) + Vector3.new(0,row*3,0)
            elseif formationType=="tower" then
                local base  = math.max(1, math.floor(math.sqrt(totalBots)))
                local level = math.floor((slotNumber-1)/base)
                local index = (slotNumber-1)%base
                pos = targetRoot.Position - look*5 + right*((index-(base-1)/2)*3) + Vector3.new(0,level*4,0)
            elseif formationType=="dlh" then
                local stem  = math.floor(totalBots/2)
                local horiz = totalBots-stem
                if slotNumber<=stem then
                    pos = targetRoot.Position - look*(5+(slotNumber-1)*3)
                else
                    local idx = slotNumber-stem
                    pos = targetRoot.Position - look*5 + right*((idx-(horiz-1)/2)*3)
                end
            elseif formationType=="staircase" then
                -- closer steps, each 2 studs higher, starting lower
                pos = targetRoot.Position + look*(4+(slotNumber-1)*3.5) + Vector3.new(0,(slotNumber-1)*2-0.5,0)
            elseif formationType=="bridge" then
                pos = targetRoot.Position + look*(6+(slotNumber-1)*6)
            elseif formationType=="bodyguard" then
                -- slot1 back-left, slot2 back-right, slot3 front-left, slot4 front-right
                -- (extra bots form a wider ring)
                local spots = {{-1,-1},{1,-1},{-1,1},{1,1}}
                local s = spots[((slotNumber-1)%4)+1]
                local d = 4 + math.floor((slotNumber-1)/4)*4
                pos = targetRoot.Position + right*(s[1]*d) + look*(s[2]*d)
            end
            if pos then
                myRoot.CFrame = faceTarget
                    and CFrame.lookAt(pos, targetRoot.Position)
                    or  CFrame.lookAt(pos, pos+look)
                disableAnimations_g()
                if movementPlatform then movementPlatform.CFrame=CFrame.new(myRoot.Position-Vector3.new(0,3,0)) end
            end
        end
        if follow or flapping then
            formationConnection = RunService.Heartbeat:Connect(doTeleport)
            table.insert(allConnections, formationConnection)
        else
            doTeleport()
        end
    end

    local function startOrbit(target, inplace)
        stopAllMovement()
        if inplace then createPlatform(); return end
        orbitAngle = 0   -- shared time base: every bot uses the same clock, so spacing stays even
        createPlatform(); moveMapUp()
        orbitConnection = RunService.Heartbeat:Connect(function(dt)
            local myChar, targetChar = LocalPlayer.Character, target.Character
            if not (myChar and targetChar) then return end
            local myRoot    = myChar:FindFirstChild("HumanoidRootPart")
            local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
            if not (myRoot and targetRoot) then return end
            for _, part in ipairs(myChar:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide=false end
            end
            -- even spacing: exact when the bot count is set (.mb), golden-angle spread otherwise
            local slotOffset
            if totalBots >= 2 and slotNumber <= totalBots then
                slotOffset = 2*math.pi*(slotNumber-1)/totalBots
            else
                slotOffset = (slotNumber-1)*2.39996323
            end
            local ang    = slotOffset + orbitAngle + orbitSpeed*workspace:GetServerTimeNow()
            local radius = ORBIT_DISTANCE + ((slotNumber-1)%3)*2.5     -- three lanes so bots don't stack
            local newPos = targetRoot.CFrame * Vector3.new(math.cos(ang)*radius, 0, math.sin(ang)*radius)
            myRoot.CFrame = CFrame.lookAt(newPos, targetRoot.Position)
            disableAnimations_g()
            if movementPlatform then movementPlatform.CFrame=CFrame.new(myRoot.Position-Vector3.new(0,3,0)) end
        end)
        table.insert(allConnections, orbitConnection)
    end

