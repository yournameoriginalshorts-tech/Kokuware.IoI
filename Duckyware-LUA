----------------------------------------------------------------------
-- Build engine (shared by Auto-Build and Anti-Grief auto-fix)
-- Reads two formats: the Kokuware "|colour...|" string and TCO-style JSON.
-- Team build: every bot loads the same build and builds its own slice.
----------------------------------------------------------------------
do
    local E = {raw = nil, center = nil, bottom = nil, cf = nil, busy = false, stopFlag = false,
        status = function() end}
    K.Build = E

    local SymbolToMaterial = {
        ["!"]=Enum.Material.SmoothPlastic, ["@"]=Enum.Material.Plastic,    ["#"]=Enum.Material.CeramicTiles,
        ["$"]=Enum.Material.Brick,         ["%"]=Enum.Material.WoodPlanks,  ["^"]=Enum.Material.Ice,
        ["&"]=Enum.Material.Grass,         ["*"]=Enum.Material.Sand,        ["("]=Enum.Material.Snow,
        [")"]=Enum.Material.Glass,         ["-"]=Enum.Material.Wood,        ["_"]=Enum.Material.Slate,
        ["="]=Enum.Material.Pebble,        ["+"]=Enum.Material.Marble,      ["["]=Enum.Material.Granite,
        ["]"]=Enum.Material.DiamondPlate,  ["{"]=Enum.Material.Metal,       ["}"]=Enum.Material.Asphalt,
        ["~"]=Enum.Material.Concrete,      ["`"]=Enum.Material.Pavement,    ["?"]=Enum.Material.Neon,
    }
    local MaterialToPaintName = {
        [Enum.Material.SmoothPlastic]="smooth", [Enum.Material.Plastic]="plastic",
        [Enum.Material.CeramicTiles]="tiles",   [Enum.Material.Brick]="bricks",
        [Enum.Material.WoodPlanks]="planks",    [Enum.Material.Ice]="ice",
        [Enum.Material.Grass]="grass",          [Enum.Material.Sand]="sand",
        [Enum.Material.Snow]="snow",            [Enum.Material.Glass]="glass",
        [Enum.Material.Wood]="wood",            [Enum.Material.Slate]="stone",
        [Enum.Material.Pebble]="pebble",        [Enum.Material.Marble]="marble",
        [Enum.Material.Granite]="granite",      [Enum.Material.DiamondPlate]="steel",
        [Enum.Material.Metal]="metal",          [Enum.Material.Asphalt]="asphalt",
        [Enum.Material.Concrete]="concrete",    [Enum.Material.Pavement]="pavement",
        [Enum.Material.Neon]="neon",
    }
    local MaterialSymbols, TokenToMaterial = {}, {}
    for sym, mat in pairs(SymbolToMaterial) do MaterialSymbols[mat] = sym end
    for mat, tok in pairs(MaterialToPaintName) do TokenToMaterial[tok] = mat end
    local FaceSymbols = {
        [Enum.NormalId.Left]="L", [Enum.NormalId.Right]="R", [Enum.NormalId.Top]="T",
        [Enum.NormalId.Bottom]="Bo", [Enum.NormalId.Front]="F", [Enum.NormalId.Back]="Ba",
    }
    local FaceFromSymbol = {L=Enum.NormalId.Left, R=Enum.NormalId.Right, T=Enum.NormalId.Top,
        Bo=Enum.NormalId.Bottom, F=Enum.NormalId.Front, Ba=Enum.NormalId.Back}

    local function hexToColor(hex)
        return Color3.new(tonumber(hex:sub(1,2),16)/255, tonumber(hex:sub(3,4),16)/255, tonumber(hex:sub(5,6),16)/255)
    end
    local function colorToHex(c)
        return string.format("%02X%02X%02X", math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
    end
    local function colorClose(a, b)
        return math.abs(a.R-b.R) < 0.008 and math.abs(a.G-b.G) < 0.008 and math.abs(a.B-b.B) < 0.008
    end
    -- centre of the nearest 4-stud grid cell (coords = 2 mod 4)
    local function snapGrid(v)
        return Vector3.new(math.floor(v.X/4)*4+2, math.floor(v.Y/4)*4+2, math.floor(v.Z/4)*4+2)
    end
    E.snapGrid = snapGrid
    local function mod4(n) return ((n % 4) + 4) % 4 end

    local function transformSize(size, rCF)
        local rx, ry, rz = rCF.RightVector, rCF.UpVector, rCF.LookVector
        return Vector3.new(
            math.round(math.abs(rx.X)*size.X+math.abs(ry.X)*size.Y+math.abs(rz.X)*size.Z),
            math.round(math.abs(rx.Y)*size.X+math.abs(ry.Y)*size.Y+math.abs(rz.Y)*size.Z),
            math.round(math.abs(rx.Z)*size.X+math.abs(ry.Z)*size.Y+math.abs(rz.Z)*size.Z))
    end
    local normalVecs = {
        [Enum.NormalId.Right]=Vector3.new(1,0,0), [Enum.NormalId.Left]=Vector3.new(-1,0,0),
        [Enum.NormalId.Top]=Vector3.new(0,1,0),   [Enum.NormalId.Bottom]=Vector3.new(0,-1,0),
        [Enum.NormalId.Back]=Vector3.new(0,0,1),  [Enum.NormalId.Front]=Vector3.new(0,0,-1),
    }
    local function transformNormalId(normalId, rCF)
        local v = normalVecs[normalId]; if not v then return normalId end
        local rv = rCF:VectorToWorldSpace(v)
        local best, bestDot = normalId, -math.huge
        for face, vec in pairs(normalVecs) do
            local d = rv:Dot(vec); if d > bestDot then bestDot, best = d, face end
        end
        return best
    end

    ---------------------------------------------------------------- parsing
    local function stringToRaw(buildStr)
        local raw = {}
        for blockData in buildStr:gmatch("|([^|]+)") do
            local colorHex       = blockData:sub(1,6)
            local materialSymbol = blockData:sub(7,7)
            local rest           = blockData:sub(8)
            local canCollide     = true
            if rest:sub(1,1) == "^" then canCollide = false; rest = rest:sub(2) end
            local sizeData, posData, extraData = rest:match("^([%d,]+)%.([%-%.%d,]+)%.?(.*)")
            if sizeData and posData and colorHex:match("^%x%x%x%x%x%x$") then
                local sx, sy, sz = sizeData:match("(%d+),(%d+),(%d+)")
                local px, py, pz = posData:match("(%-?%d+%.?%d*),(%-?%d+%.?%d*),(%-?%d+%.?%d*)")
                if sx and px then
                    local sprays = {}
                    if extraData and extraData ~= "" then
                        for face, text, color in extraData:gmatch('(%a+)"([^"]*)""([^"]*)"') do
                            if FaceFromSymbol[face] and #color == 6 then
                                table.insert(sprays, {face = FaceFromSymbol[face], text = text, colorHex = color})
                            end
                        end
                    end
                    table.insert(raw, {
                        size = Vector3.new(tonumber(sx), tonumber(sy), tonumber(sz)),
                        pos = Vector3.new(tonumber(px), tonumber(py), tonumber(pz)),
                        color = hexToColor(colorHex),
                        material = SymbolToMaterial[materialSymbol] or Enum.Material.SmoothPlastic,
                        canCollide = canCollide, anchored = true, sprays = sprays,
                    })
                end
            end
        end
        return raw
    end

    local function arr3(v)
        if type(v) ~= "table" then return nil end
        local x, y, z = tonumber(v[1] or v.x or v.X), tonumber(v[2] or v.y or v.Y), tonumber(v[3] or v.z or v.Z)
        if x and y and z then return Vector3.new(x, y, z) end
        return nil
    end

    local function jsonToRaw(list)
        local raw = {}
        for _, b in ipairs(list) do
            if type(b) == "table" then
                local p = arr3(b.p or b.pos or b.position)
                if p then
                    local s = arr3(b.s or b.size)
                    local size = s or Vector3.new(4, 4, 4)
                    local center = s and (p + s/2 - Vector3.new(0.5, 0.5, 0.5)) or p
                    local col = Color3.fromRGB(192, 192, 192)
                    local cv = arr3(b.c or b.color)
                    if cv then
                        if cv.X <= 1 and cv.Y <= 1 and cv.Z <= 1 then cv = cv * 255 end
                        col = Color3.fromRGB(math.clamp(math.floor(cv.X), 0, 255), math.clamp(math.floor(cv.Y), 0, 255), math.clamp(math.floor(cv.Z), 0, 255))
                    end
                    local mat = TokenToMaterial[tostring(b.m or b.mat or b.material or ""):lower()]
                    if not mat and b.o then
                        pcall(function() mat = Enum.Material[tostring(b.o)] end)
                    end
                    local cc = b.cc
                    if cc == nil then cc = b.collide end
                    if cc == nil then cc = true end
                    local anch = b.a
                    if anch == nil then anch = b.anchored end
                    if anch == nil then anch = true end
                    local sprays = {}
                    for _, sp in ipairs(b.sp or b.sprayed or b.sprays or {}) do
                        if type(sp) == "table" then
                            local face
                            pcall(function() face = Enum.NormalId[tostring(sp[1])] end)
                            local text = (sp[3] ~= nil and sp[3] ~= "") and tostring(sp[3]) or (type(sp[2]) == "string" and sp[2] or "")
                            if face and text ~= "" then
                                table.insert(sprays, {face = face, text = text, colorHex = "FFFFFF"})
                            end
                        end
                    end
                    table.insert(raw, {size = size, pos = center, color = col, material = mat or Enum.Material.SmoothPlastic,
                        canCollide = cc, anchored = anch, sprays = sprays})
                end
            end
        end
        return raw
    end

    local function looksLikeBlocks(t)
        local f = type(t) == "table" and t[1]
        return type(f) == "table" and (f.p or f.pos or f.position) ~= nil
    end
    local function findBlocks(v, depth)
        if type(v) ~= "table" or depth > 5 then return nil end
        if looksLikeBlocks(v) then return v end
        if type(v.payload) == "string" and v.payload:sub(1, 7) == "GLAVA3:" then
            local ok, dec = pcall(function() return HttpService:JSONDecode(v.payload:sub(8)) end)
            if ok then return findBlocks(dec, depth + 1) end
        end
        if type(v[1]) == "table" then
            local got = findBlocks(v[1], depth + 1)
            if got then return got end
        end
        for _, key in ipairs({"buildData", "blocks", "data", "build", "ServerBuilds", "serverBuilds"}) do
            local got = findBlocks(v[key], depth + 1)
            if got then return got end
        end
        if looksLikeBlocks({v}) then return {v} end
        return nil
    end

    -- returns block count, or nil + error
    function E.load(text)
        local t = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if t == "" then return nil, "empty build" end
        if t:sub(1, 7) == "GLAVA3:" then t = t:sub(8) end
        local raw
        local c = t:sub(1, 1)
        if c == "{" or c == "[" then
            local ok, data = pcall(function() return HttpService:JSONDecode(t) end)
            if not ok then return nil, "that JSON is broken (parse error)" end
            local list = findBlocks(data, 0)
            if not list then return nil, "no blocks found in that JSON" end
            raw = jsonToRaw(list)
        elseif t:sub(1, 7) == "GLAVA1:" or t:sub(1, 7) == "GLAVA2:" then
            return nil, "that's an encrypted TCO export - re-export it as plain JSON"
        else
            raw = stringToRaw(t)
        end
        if #raw == 0 then return nil, "no valid blocks found" end
        local sum, minBottom = Vector3.zero, math.huge
        for _, r in ipairs(raw) do
            sum += r.pos
            minBottom = math.min(minBottom, r.pos.Y - r.size.Y / 2)
        end
        E.raw, E.center, E.bottom = raw, snapGrid(sum / #raw), minBottom
        return #raw
    end

    local function httpGet(url)
        local ok, body = pcall(function() return game:HttpGet(url) end)
        if ok and type(body) == "string" and body ~= "" then return body end
        return nil
    end
    function E.loadUrl(url)
        local body = httpGet(tostring(url or ""))
        if not body then return nil, "couldn't download that link" end
        return E.load(body)
    end
    function E.loadPaste(id)
        return E.loadUrl("https://pastebin.com/raw/" .. (tostring(id or ""):gsub("[^%w]", "")))
    end
    function E.loadFile(name)
        name = tostring(name or ""):gsub("[^%w%._%-% ]", "")
        if name == "" then return nil, "no file name" end
        if not name:find("%.") then name = name .. ".json" end
        local path = BUILD_DIR .. "/" .. name
        local ok, body = pcall(function() return isfile and isfile(path) and readfile(path) end)
        if not ok or type(body) ~= "string" then return nil, "file not found: " .. path end
        return E.load(body)
    end

    ---------------------------------------------------------------- layout
    function E.layout()
        if not E.raw then return nil end
        local targetCF = E.cf or CFrame.new(E.center)
        local rotOnly = targetCF - targetCF.Position
        local blocks = {}
        for _, r in ipairs(E.raw) do
            local centerPos = (targetCF * CFrame.new(r.pos - E.center)).Position
            local size = transformSize(r.size, rotOnly)
            local is4 = (size == Vector3.new(4, 4, 4))
            local onGrid = (math.abs(mod4(centerPos.X) - 2) < 0.01)
                       and (math.abs(mod4(centerPos.Y) - 2) < 0.01)
                       and (math.abs(mod4(centerPos.Z) - 2) < 0.01)
            local sprays = {}
            for _, s in ipairs(r.sprays) do
                table.insert(sprays, {face = transformNormalId(s.face, rotOnly), text = s.text, colorHex = s.colorHex})
            end
            table.insert(blocks, {size = size, centerPos = centerPos, color = r.color, material = r.material,
                canCollide = r.canCollide, anchored = r.anchored, needsResize = not (is4 and onGrid), sprays = sprays})
        end
        return blocks
    end

    -- team split: sort the same way on every bot, then give each bot one contiguous strip
    function E.share(blocks, index, total)
        if total <= 1 then return blocks end
        for i, b in ipairs(blocks) do b._i = i end
        local sorted = table.clone(blocks)
        table.sort(sorted, function(a, b)
            local ax, bx = math.floor(a.centerPos.X * 10 + 0.5), math.floor(b.centerPos.X * 10 + 0.5)
            if ax ~= bx then return ax < bx end
            local az, bz = math.floor(a.centerPos.Z * 10 + 0.5), math.floor(b.centerPos.Z * 10 + 0.5)
            if az ~= bz then return az < bz end
            local ay, by = math.floor(a.centerPos.Y * 10 + 0.5), math.floor(b.centerPos.Y * 10 + 0.5)
            if ay ~= by then return ay < by end
            return a._i < b._i
        end)
        local per = math.ceil(#sorted / total)
        local from = index * per + 1
        local to = math.min(#sorted, from + per - 1)
        local out = {}
        for i = from, to do out[#out + 1] = sorted[i] end
        return out
    end

    -- turns a live brick into a block entry (used by Anti-Grief auto-fix and saving)
    function E.brickToBlock(b)
        local size = b.Size
        local sprays = {}
        for _, child in ipairs(b:GetChildren()) do
            if child:IsA("SurfaceGui") then
                local label = child:FindFirstChildWhichIsA("TextLabel", true)
                local img = child:FindFirstChildWhichIsA("ImageLabel", true)
                local text = label and label.Text or ""
                if text == "" and img and img.Image ~= "" then text = img.Image end
                if text ~= "" then
                    table.insert(sprays, {face = child.Face, text = text, colorHex = colorToHex(label and label.TextColor3 or Color3.new(1, 1, 1))})
                end
            end
        end
        local pos = b.Position
        local onGrid = (math.abs(mod4(pos.X) - 2) < 0.01) and (math.abs(mod4(pos.Y) - 2) < 0.01) and (math.abs(mod4(pos.Z) - 2) < 0.01)
        return {size = size, centerPos = pos, color = b.Color, material = b.Material, canCollide = b.CanCollide,
            anchored = b.Anchored, needsResize = not (size == Vector3.new(4, 4, 4) and onGrid), sprays = sprays}
    end

    ---------------------------------------------------------------- tools
    local function findToolByName(toolName)
        for _, loc in pairs({LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack")}) do
            if loc then
                for _, item in pairs(loc:GetChildren()) do
                    if item:IsA("Tool") and item.Name == toolName then
                        local scr    = item:FindFirstChild("Script", true)
                        local remote = (scr and scr:FindFirstChild("Event")) or item:FindFirstChild("Event", true)
                        if remote then return {tool = item, event = remote} end
                    end
                end
            end
        end
        return nil
    end
    local function missingTools(needShape)
        local out = {}
        local need = {"Build", "Paint"}
        if needShape then table.insert(need, "Shape") end
        for _, n in ipairs(need) do
            if not findToolByName(n) then table.insert(out, n) end
        end
        return out
    end
    local function getHRP()
        local c = LocalPlayer.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end
    local function getPlayerBricksFolder()
        local bf = workspace:FindFirstChild("Bricks")
        return bf and bf:FindFirstChild(LocalPlayer.Name)
    end
    local function getBrickCount()
        local pf = getPlayerBricksFolder(); if not pf then return 0 end
        local c = 0
        for _, b in pairs(pf:GetChildren()) do if b:IsA("BasePart") and b.Name == "Brick" then c += 1 end end
        return c
    end
    local function getNewestBrick()
        local pf = getPlayerBricksFolder(); if not pf then return nil end
        local newest
        for _, b in pairs(pf:GetChildren()) do if b:IsA("BasePart") and b.Name == "Brick" then newest = b end end
        return newest
    end

    local noclipConn, toolConn, forcing, posLock = nil, nil, false, nil
    local function enableNoclip()
        if noclipConn then noclipConn:Disconnect() end
        noclipConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character; if not char then return end
            for _, part in pairs(char:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end)
    end
    local function disableNoclip()
        if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end
    local TOOL_NAMES = {Build = true, Paint = true, Shape = true, Delete = true}
    local function startToolForcing()
        forcing = true
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if LocalPlayer.Character and bp then
            for _, tool in pairs(bp:GetChildren()) do
                if tool:IsA("Tool") and TOOL_NAMES[tool.Name] then tool.Parent = LocalPlayer.Character end
            end
        end
        if toolConn then toolConn:Disconnect() end
        if bp then
            toolConn = bp.ChildAdded:Connect(function(tool)
                if not forcing then return end
                if tool:IsA("Tool") and TOOL_NAMES[tool.Name] then
                    task.wait(0.01)
                    if LocalPlayer.Character and tool.Parent == bp then tool.Parent = LocalPlayer.Character end
                end
            end)
        end
    end
    local function stopToolForcing()
        forcing = false
        if toolConn then toolConn:Disconnect(); toolConn = nil end
    end
    local function lockPosition(targetPos)
        if posLock then posLock:Disconnect() end
        posLock = RunService.Heartbeat:Connect(function()
            local hrp = getHRP()
            if hrp then
                hrp.CFrame = CFrame.new(targetPos)
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    end
    local function unlockPosition() if posLock then posLock:Disconnect(); posLock = nil end end

    local function findBlockNear(targetPos, radius)
        local pf = getPlayerBricksFolder(); if not pf then return nil end
        local best, bestDist = nil, radius or 1
        for _, b in pairs(pf:GetChildren()) do
            if b:IsA("BasePart") and b.Name == "Brick" then
                local d = (b.Position - targetPos).Magnitude
                if d < bestDist then best, bestDist = b, d end
            end
        end
        return best
    end
    local function getCornerPosition(centerPos, size)
        local h = size / 2
        return Vector3.new(centerPos.X - h.X + 0.5, centerPos.Y - h.Y + 0.5, centerPos.Z - h.Z + 0.5)
    end

    -- only fires Paint when the brick doesn't already look right
    local function paintBlock(brick, color, material)
        local pt, hrp = findToolByName("Paint"), getHRP()
        if not (pt and hrp) then return false end
        local mname = MaterialToPaintName[material] or "smooth"
        for _ = 1, 3 do
            if not brick.Parent then return false end
            if colorClose(brick.Color, color) and brick.Material == material then return true end
            pcall(function() pt.event:FireServer(brick, Enum.NormalId.Left, hrp.Position, "both", color, mname, "") end)
            task.wait(0.06)
        end
        return true
    end
    local function sprayBlock(brick, face, text, colorHex)
        local pt, hrp = findToolByName("Paint"), getHRP()
        if not (pt and hrp) then return false end
        pcall(function() pt.event:FireServer(brick, face, hrp.Position, "both", hexToColor(colorHex), "spray", text) end)
        return true
    end
    local function anchorBlock(brick, want)
        local pt, hrp = findToolByName("Paint"), getHRP()
        if not (pt and hrp) then return end
        for _ = 1, 4 do
            if not brick.Parent or brick.Anchored == want then return end
            pcall(function() pt.event:FireServer(brick, Enum.NormalId.Top, hrp.Position, "material", nil, "anchor", "") end)
            task.wait(0.15)
        end
    end
    local function resizeBlock(brick, targetSize)
        local st, hrp = findToolByName("Shape"), getHRP()
        if not (st and brick and hrp) then return false end
        local pos = hrp.Position
        local rightN = math.floor(targetSize.X - 1)
        local topN   = math.floor(targetSize.Y - 1)
        local backN  = math.floor(targetSize.Z - 1)
        for i = 1, math.max(rightN, topN, backN) do
            local b = getNewestBrick(); if not b then return false end
            if i <= rightN then pcall(function() st.event:FireServer(b, Enum.NormalId.Right, pos, "increase") end); task.wait(0.07) end
            b = getNewestBrick(); if not b then return false end
            if i <= topN   then pcall(function() st.event:FireServer(b, Enum.NormalId.Top,   pos, "increase") end); task.wait(0.07) end
            b = getNewestBrick(); if not b then return false end
            if i <= backN  then pcall(function() st.event:FireServer(b, Enum.NormalId.Back,  pos, "increase") end); task.wait(0.07) end
        end
        return true
    end

    local function placeBlock(bd)
        local bt = findToolByName("Build")
        if not bt then return false end
        local placePos = bd.needsResize and getCornerPosition(bd.centerPos, bd.size) or bd.centerPos
        lockPosition(placePos + Vector3.new(0, 12, 0))
        if findBlockNear(bd.centerPos, 1) then return true end -- already built
        task.wait(0.03)
        local placeMode = not bd.canCollide
            and (bd.needsResize and "detailed nocollide" or "nocollide")
            or  (bd.needsResize and "detailed" or "normal")
        local initial = getBrickCount()
        local retryDelay = bd.canCollide and 0.05 or 0.2
        pcall(function() bt.event:FireServer(workspace.Terrain, Enum.NormalId.Top, placePos, placeMode) end)
        local attempts = 0
        while getBrickCount() == initial and attempts < 40 do
            task.wait(retryDelay); attempts += 1
            pcall(function() bt.event:FireServer(workspace.Terrain, Enum.NormalId.Top, placePos, placeMode) end)
        end
        if getBrickCount() == initial then return false end
        local newBrick = getNewestBrick(); if not newBrick then return false end
        task.wait(0.02)
        paintBlock(newBrick, bd.color, bd.material)
        for _, spray in ipairs(bd.sprays or {}) do
            task.wait(0.03)
            sprayBlock(newBrick, spray.face, spray.text, spray.colorHex)
        end
        if bd.needsResize and bd.size ~= Vector3.new(1, 1, 1) then
            task.wait(0.02)
            resizeBlock(newBrick, bd.size)
        end
        if bd.anchored == false then anchorBlock(newBrick, false) end
        return true
    end
    E.placeBlock = placeBlock

    ---------------------------------------------------------------- runner
    function E.stop() E.stopFlag = true end

    -- blocks: laid-out list (already split for this bot if it's a team build)
    -- opts: credit (announce Mikey in chat), label
    function E.run(blocks, opts)
        opts = opts or {}
        if E.busy then return false, "already building" end
        if #blocks == 0 then E.status("Nothing to build for this bot"); return false, "empty" end
        local needShape = false
        for _, b in ipairs(blocks) do
            if b.needsResize and b.size ~= Vector3.new(1, 1, 1) then needShape = true; break end
        end
        local missing = missingTools(needShape)
        if #missing > 0 then
            E.status("Missing tool: " .. table.concat(missing, ", "))
            addLogEntry("[AutoBuild] missing tool: " .. table.concat(missing, ", "), Color3.fromRGB(255, 80, 80))
            return false, "tools"
        end
        E.busy, E.stopFlag = true, false
        if opts.credit then
            sendRaw("Auto-Build -Credits to Mikey-")
            addLogEntry("[AutoBuild] Credits to Mikey")
        end
        local label = opts.label or "Building"
        startToolForcing(); enableNoclip()

        local total, finished, skipped = #blocks, 0, 0
        local ok, err = pcall(function()
            local done, fails = {}, {}
            local function nearestUnbuilt(hrp)
                local bestI, bestD = nil, math.huge
                for i, b in ipairs(blocks) do
                    if not done[i] then
                        local d = (hrp.Position - b.centerPos).Magnitude
                        if d < bestD then bestD, bestI = d, i end
                    end
                end
                return bestI
            end
            while finished < total do
                if E.stopFlag then break end
                local hrp = getHRP()
                if not hrp then
                    task.wait(0.5) -- dead / respawning
                else
                    if #missingTools(needShape) > 0 then E.status("Tool lost - stopped"); E.stopFlag = true; break end
                    local i = nearestUnbuilt(hrp)
                    if not i then break end
                    if placeBlock(blocks[i]) then
                        done[i] = true; finished += 1
                    else
                        fails[i] = (fails[i] or 0) + 1
                        if fails[i] >= 3 then done[i] = true; finished += 1; skipped += 1 end
                    end
                    unlockPosition()
                    E.status(label .. " " .. finished .. "/" .. total .. (skipped > 0 and (" (" .. skipped .. " skipped)") or ""))
                    task.wait(0.03)
                end
            end
            -- verify / repair: re-place anything that isn't actually there
            for pass = 1, 2 do
                if E.stopFlag then break end
                local have = {}
                local pf = getPlayerBricksFolder()
                if pf then
                    for _, b in ipairs(pf:GetChildren()) do
                        if b:IsA("BasePart") and b.Name == "Brick" then
                            local p = b.Position
                            have[math.floor(p.X * 2 + 0.5) .. "," .. math.floor(p.Y * 2 + 0.5) .. "," .. math.floor(p.Z * 2 + 0.5)] = true
                        end
                    end
                end
                local missingList = {}
                for _, b in ipairs(blocks) do
                    local p = b.centerPos
                    if not have[math.floor(p.X * 2 + 0.5) .. "," .. math.floor(p.Y * 2 + 0.5) .. "," .. math.floor(p.Z * 2 + 0.5)] then
                        missingList[#missingList + 1] = b
                    end
                end
                if #missingList == 0 then break end
                E.status("Repair pass " .. pass .. ": " .. #missingList .. " missing")
                for _, b in ipairs(missingList) do
                    if E.stopFlag then break end
                    if getHRP() then
                        if placeBlock(b) and skipped > 0 then skipped -= 1 end
                        unlockPosition()
                    else
                        task.wait(0.5)
                    end
                    task.wait(0.03)
                end
            end
        end)

        unlockPosition(); stopToolForcing(); disableNoclip()
        E.busy = false
        if not ok then
            E.status("Error: " .. tostring(err))
            addLogEntry("[AutoBuild] error: " .. tostring(err), Color3.fromRGB(255, 80, 80))
        elseif E.stopFlag then
            E.status("Stopped at " .. finished .. "/" .. total)
        else
            E.status("Done " .. (total - skipped) .. "/" .. total)
            addLogEntry("[AutoBuild] " .. label .. " done: " .. (total - skipped) .. "/" .. total)
        end
        return ok
    end

    -- starts a build from the loaded data. team = split between bots.
    function E.start(team, index, total, credit)
        if E.busy then return false, "already building" end
        local blocks = E.layout()
        if not blocks then return false, "no build loaded" end
        if team then blocks = E.share(blocks, index, total) end
        task.spawn(function()
            E.run(blocks, {credit = credit, label = team and ("Team build (" .. (index + 1) .. "/" .. total .. ")") or "Building"})
        end)
        return true, #blocks
    end

    ---------------------------------------------------------------- saving
    function E.collect(mode)
        local bf = workspace:FindFirstChild("Bricks")
        if not bf then return {} end
        local root = (mode == "You") and bf:FindFirstChild(LocalPlayer.Name) or bf
        local out = {}
        if root then
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("BasePart") and d.Name == "Brick" then out[#out + 1] = d end
            end
        end
        return out
    end

    function E.exportString(bricks)
        local parts = {}
        for _, d in ipairs(bricks) do
            if d.Anchored then
                local size = d.Size
                if not (size.X % 1 ~= 0 or size.Y % 1 ~= 0 or size.Z % 1 ~= 0) then
                    local cf = d.CFrame
                    local sprays = {}
                    for _, child in ipairs(d:GetChildren()) do
                        if child:IsA("SurfaceGui") then
                            local label = child:FindFirstChildWhichIsA("TextLabel", true)
                            local fsym = FaceSymbols[child.Face]
                            if label and fsym and label.Text ~= "" then
                                table.insert(sprays, string.format('%s"%s""%s"', fsym, (label.Text:gsub('"', "'")), colorToHex(label.TextColor3)))
                            end
                        end
                    end
                    local sprayStr = #sprays > 0 and ("." .. table.concat(sprays, "..")) or ""
                    table.insert(parts, string.format("|%s%s%s%.0f,%.0f,%.0f.%.1f,%.1f,%.1f%s.|",
                        colorToHex(d.Color), MaterialSymbols[d.Material] or "!", d.CanCollide and "" or "^",
                        size.X, size.Y, size.Z, cf.X, cf.Y, cf.Z, sprayStr))
                end
            end
        end
        return table.concat(parts), #parts
    end

    -- TCO-compatible JSON: {p, c, a, cc, m, o, s, sp}
    function E.exportJSON(bricks)
        local out = {}
        for _, d in ipairs(bricks) do
            local size, pos, c = d.Size, d.Position, d.Color
            local blk = {
                p = {pos.X, pos.Y, pos.Z},
                c = {math.round(c.R * 255), math.round(c.G * 255), math.round(c.B * 255)},
                a = d.Anchored, cc = d.CanCollide,
                m = MaterialToPaintName[d.Material], o = d.Material.Name,
            }
            if size.X ~= 4 or size.Y ~= 4 or size.Z ~= 4 then
                blk.p = {pos.X - size.X / 2 + 0.5, pos.Y - size.Y / 2 + 0.5, pos.Z - size.Z / 2 + 0.5}
                blk.s = {size.X, size.Y, size.Z}
            end
            local sp = {}
            for _, child in ipairs(d:GetChildren()) do
                if child:IsA("SurfaceGui") then
                    local label = child:FindFirstChildWhichIsA("TextLabel", true)
                    if label and label.Text ~= "" then table.insert(sp, {child.Face.Name, "", label.Text}) end
                end
            end
            if #sp > 0 then blk.sp = sp end
            out[#out + 1] = blk
        end
        return HttpService:JSONEncode(out)
    end

    function E.saveFile(name, text)
        pcall(function() if makefolder then makefolder(BUILD_DIR) end end)
        local ok = pcall(function() writefile(BUILD_DIR .. "/" .. name .. ".json", text) end)
        return ok
    end
end

