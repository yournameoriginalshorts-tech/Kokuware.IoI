    if not antiLagActive then return end
    antiLagActive = false
    if antiLagLoop then antiLagLoop:Disconnect(); antiLagLoop = nil end
    pcall(function()
        local L = game:GetService("Lighting")
        L.GlobalShadows = true; L.ShadowSoftness = 1
        L.Technology = Enum.Technology.ShadowMap
        L.EnvironmentDiffuseScale = 1; L.EnvironmentSpecularScale = 1
