        if plr.Character then scan(plr.Character) end
        table.insert(allConnections, plr.CharacterAdded:Connect(function(ch) scan(ch) end))
        scan(plr:FindFirstChildOfClass("Backpack"))
        table.insert(allConnections, plr.ChildAdded:Connect(function(c)
