    local danceTrack, danceGen = nil, 0
    local function stopDance()
        danceGen += 1
        if danceTrack then
            pcall(function() danceTrack:Stop(); danceTrack:Destroy() end)
            danceTrack = nil
        end
    end

    -- waits until the animation has actually loaded (Length > 0)
    local function trackLoaded(track)
        local t0 = os.clock()
        while track.Length == 0 and os.clock() - t0 < 2 do task.wait(0.05) end
        return track.Length > 0
    end

    -- Tries 3 ways to play the emote, in order, until one really works:
    --  1) Humanoid:PlayEmoteAndGetAnimTrackById (official emote API, replicates)
    --  2) GetObjects on the asset to find the real Animation inside it
    --  3) plain rbxassetid:// animation
    local function startDance(n)
        stopDance()
        local myDance = danceGen
        local id = DANCES[n]; if not id then return end
        local char = LocalPlayer.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then addLogEntry("[Dance] no humanoid found"); return end
        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then animator = Instance.new("Animator"); animator.Parent = hum end
        local numId = tonumber(id)

        local methods = {
            {name="emote API", play=false, fn=function()
                return hum:PlayEmoteAndGetAnimTrackById(numId)
            end},
            {name="asset animation", play=true, fn=function()
                for _, o in ipairs(game:GetObjects("rbxassetid://"..id)) do
                    local a = o:IsA("Animation") and o or o:FindFirstChildWhichIsA("Animation", true)
                    if a then return animator:LoadAnimation(a) end
                    local ks = o:IsA("KeyframeSequence") and o or o:FindFirstChildWhichIsA("KeyframeSequence", true)
                    if ks then
                        local anim = Instance.new("Animation")
                        anim.AnimationId = game:GetService("KeyframeSequenceProvider"):RegisterKeyframeSequence(ks)
                        return animator:LoadAnimation(anim)
                    end
                end
            end},
            {name="direct id", play=true, fn=function()
                local anim = Instance.new("Animation")
                anim.AnimationId = "rbxassetid://"..id
                return animator:LoadAnimation(anim)
            end},
        }

        for _, m in ipairs(methods) do
            if myDance ~= danceGen then return end -- a newer dance/stop was issued
            local ok, track = pcall(m.fn)
            if ok and track then
                track.Looped   = true
                track.Priority = Enum.AnimationPriority.Action4
                if m.play then pcall(function() track:Play() end) end
                if trackLoaded(track) then
                    if myDance ~= danceGen then pcall(function() track:Stop() end); return end
                    danceTrack = track
                    addLogEntry("[Dance] "..n.." playing via "..m.name)
                    return
                end
                pcall(function() track:Stop() end)
            end
        end
        addLogEntry("[Dance] "..n.." failed (R6 rig, or this emote can't be used in this game)", Color3.fromRGB(255,80,80))
    end

    local allCommands = ".say .loopsay .stoploop .dall .adall .stopadall .silent .hide .stophide .reset .rejoin .antiafk .antilag .antigrief .anticlone .form .stopform .line .circle .orbit .lineup .star .wall .tower .dlh .staircase .bridge .bodyguard .dance .dances .R6 .spydebug .stopdance .follow .stopmove .tp .mod .removemod .alert .credits .cmds .bots .botscheck .mb .raidcalc .orbitspeed .prefix .animations .msgcmds .msgcheck .msg .blacklist .unblacklist .whitelist .logs .logmode .sign .bully .unbully .autoclicker .keyboard .autobuild .unload .shutdown"

    local formNames    = {line=true,circle=true,lineup=true,star=true,wall=true,tower=true,dlh=true,staircase=true,bridge=true,bodyguard=true}
    local announceForms = {wall=true,tower=true,dlh=true,staircase=true,bridge=true,bodyguard=true}

    local function handleFormation(sender, formType, argsText, announce)
        local follow, inplace, tgtText = false, false, nil
        for w in argsText:gmatch("%S+") do
            local l=w:lower()
            if l=="follow" then follow=true
            elseif l==Inplace then inplace=true
            else tgtText=w end
        end
        local tgt = getTarget(tgtText or sender.Name)
        if tgt then
            startFormation(tgt, formType, follow, inplace)
            if announce and messageToggles.formation then
                sendChat("formation:"..formType.." ("..(tgtText or tgt.Name)..")")
            end
        end
    end

    local function processCommand(sender, message)
        if not sender or not message then return end
        if blacklist[sender.UserId] then return end
        local clean = message:lower():gsub("^%s+",""):gsub("%s+$","")
        if clean:sub(1,#Prefix)~=Prefix and clean:sub(1,1)~=";" then return end
        if clean:sub(1,1)==";" then clean=Prefix..clean:sub(2) end

        -- you can always open your own log window with .logs
        local earlyName = clean:sub(#Prefix+1):match("^(%S+)")
        if not (sender == LocalPlayer and earlyName == "logs") and not isAllowed(sender) then
            if earlyName and (" "..allCommands.." "):find(" ."..earlyName.." ", 1, true) then
                addLogEntry("[Denied] "..sender.Name.." tried ."..earlyName.." (not owner/mod on this bot)", Color3.fromRGB(255,80,80))
            end
            return
        end

        _G.DuckywareLast = _G.DuckywareLast or {}
        local key = sender.UserId..":"..message
        local now = os.clock()
        local last = _G.DuckywareLast
        if last[key] and now-last[key]<0.5 then return end
        last[key] = now
        if sender ~= LocalPlayer and not isOwner(sender) then
            addLogEntry("[Mod cmd] "..sender.Name..": "..message)
        end

        local name    = clean:sub(#Prefix+1):match("^(%S+)")
        if not name then return end
        local rawArgs  = message:match("^%s*%S+%s*(.-)%s*$") or ""
        local lowerArgs = rawArgs:lower()

        if name=="shutdown" then
            if isOwner(sender) then pcall(function() LocalPlayer:Kick("Shutdown by owner") end) end

        elseif name=="unload" then
            cleanupConnections(); stopAllMovement()
            spyAlive = false
            r6On = false; _G.DuckywareR6Hook = nil
            antiCloneOn = false
            if antiLagLoop then antiLagLoop:Disconnect(); antiLagLoop=nil end
            if autobuildGui   then autobuildGui:Destroy()   end
            if autoclickerGui then autoclickerGui:Destroy() end
            if keyboardGui    then keyboardGui:Destroy()    end
            logGui:Destroy()
            sendChat("Unloaded")

        elseif name=="logs" then
            if sender ~= LocalPlayer then toggleLogs() end   -- your own .logs is handled by the chat logger

        elseif name=="logmode" then
            if lowerArgs=="cmds" or lowerArgs=="all" then
                spyMode = lowerArgs
                addLogEntry("[Logs] now logging "..spyMode)
                sendChat("Log mode: "..spyMode)
            else
                sendChat("Usage: .logmode all | cmds")
            end

        elseif name=="blacklist" then
            if not isOwner(sender) or rawArgs=="" then return end
            -- .blacklist (261439002)  -> blocks that gear
            local gid = rawArgs:match("%((%d+)%)") or lowerArgs:match("^gear%s+(%d+)$")
            if gid then
                gid = tonumber(gid)
                local nm = resolveGearName(gid)
                gearBlacklist[gid] = nm
                saveGearBlacklist()
                checkAllToolsNow()
                sendChat("Blacklisted gear "..gid..(nm ~= "" and (" ("..nm..")") or ""))
                addLogEntry("[GearBlock] added "..gid..(nm ~= "" and (" ("..nm..")") or ""))
                return
            end
            local uid, uname = resolveUser(rawArgs)
            if not uid then sendChat("User not found"); return end
            if isOwnerName(uname) then sendChat("Can't blacklist an owner"); return end
            blacklist[uid]=true; saveBlacklist()
            sendChat("Blacklisted "..uname)
            logToDiscord("Player blacklisted",{{name="Target",value=uname.." ("..uid..")",inline=true},{name="By",value=sender.Name,inline=true}},15158332)
            addLogEntry("[Blacklist] added "..uname.." ("..uid..")")

        elseif name=="unblacklist" or name=="whitelist" then
            if not isOwner(sender) or rawArgs=="" then return end
            local gid = rawArgs:match("%((%d+)%)") or lowerArgs:match("^gear%s+(%d+)$")
            if gid then
                gid = tonumber(gid)
                if gearBlacklist[gid] ~= nil then
                    gearBlacklist[gid] = nil; saveGearBlacklist()
                    sendChat("Unblacklisted gear "..gid)
                else
                    sendChat("Gear "..gid.." isn't blacklisted")
                end
                return
            end
            local uid, uname = resolveUser(rawArgs)
            if uid then blacklist[uid]=nil; saveBlacklist(); sendChat("Unblacklisted "..uname) end

        elseif name=="anticlone" then
            if lowerArgs=="off" then
                antiCloneOn=false; sendChat("Anti-clone off")
            else
                antiCloneOn=true; sendChat("Anti-clone on")
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and looksLikeClone(obj) then queueClone(obj) end
                end
            end

        elseif name=="sign" then
            local word = lowerArgs:gsub("%s+","")
            if word~="" then
                local letter = word:sub(getSignIndex(),getSignIndex())
                sendChat(LETTER_DECALS[letter] and tostring(LETTER_DECALS[letter]) or ".")
            end

        elseif name=="rejoin" then
            pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)

        elseif name=="reset" then
            loopActive,loopMsg,adallActive=false,"",false
            stopDance(); stopAllMovement(); restoreMap()
            if hiding then hiding=false; if hidePartObj then hidePartObj:Destroy(); hidePartObj=nil end end
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health=0 end

        elseif name=="hide" then
            if not hiding then
                local char = LocalPlayer.Character
                if char then returnPos=char:GetPivot(); char:PivotTo(CFrame.new(hidePos+Vector3.new(0,3,0))) end
                hidePartObj = Instance.new("Part")
                hidePartObj.Size,hidePartObj.Position,hidePartObj.Anchored=Vector3.new(20,1,20),hidePos,true
                hidePartObj.Parent=workspace; hiding=true
            end

        elseif name=="stophide" then
            if hiding then
                hiding=false
                if hidePartObj then hidePartObj:Destroy(); hidePartObj=nil end
                local char = LocalPlayer.Character
                if char and returnPos then char:PivotTo(returnPos) end
            end

        elseif name=="stopform" or name=="stopmove" then
            stopAllMovement(); restoreMap()

        elseif name=="form" then
            local first, rest = rawArgs:match("^(%S+)%s*(.*)$")
            if first and formNames[first:lower()] then
                handleFormation(sender, first:lower(), rest, true)
            elseif not first then
                startFormation(sender, "line", false, false)
            end

        elseif formNames[name] then
            handleFormation(sender, name, rawArgs, announceForms[name])

        elseif name=="orbit" then
            local inplace = lowerArgs:find(Inplace)~=nil
            local tgtText = rawArgs:gsub(Inplace,""):gsub("^%s+",""):gsub("%s+$","")
            local tgt = getTarget(tgtText~="" and tgtText or sender.Name)
            if tgt then
                startOrbit(tgt, inplace)
                addLogEntry("[Orbit] orbiting "..tgt.Name)
            else
                addLogEntry("[Orbit] target not found: "..tostring(tgtText), Color3.fromRGB(255,80,80))
            end

        elseif name=="follow" then
            if rawArgs=="" then stopAllMovement()
            else
                local inplace = lowerArgs:find(Inplace)~=nil
                local tgtText = rawArgs:gsub(Inplace,""):gsub("^%s+",""):gsub("%s+$","")
                local tgt = getTarget(tgtText~="" and tgtText or sender.Name)
                if tgt then startFollow(tgt, inplace) end
            end

        elseif name=="tp" then
            if isOwner(sender) or ModUsers[sender.UserId] then
                local tgt = getTarget(rawArgs~="" and rawArgs or sender.Name)
                local myChar,targetChar = LocalPlayer.Character, tgt and tgt.Character
                if myChar and targetChar then
                    local myRoot    = myChar:FindFirstChild("HumanoidRootPart")
                    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
                    if myRoot and targetRoot then myRoot.CFrame=targetRoot.CFrame end
                end
            end

        elseif name=="say" then
            if rawArgs~="" then sendChat(rawArgs) end

        elseif name=="loopsay" then
            if lowerArgs=="off" or rawArgs=="" then loopActive,loopMsg=false,""
            else loopMsg,loopActive=rawArgs,true end

        elseif name=="stoploop" then
            loopActive,loopMsg,adallActive=false,"",false

        elseif name=="silent" then silentMode=not silentMode

        elseif name=="alert" then
            sendAlert(rawArgs~="" and rawArgs or ("Alert! "..sender.DisplayName.." requests your attention!"))

        elseif name=="credits" then
            sendChat("Duckyware -Credits to SomeoneStoleMyBred13-")

        elseif name=="dall" then
            local tgt = getTarget(rawArgs~="" and rawArgs or sender.Name)
            local t   = getOwnTime()
            if tgt and t and t.Value>1 then sendChat(";donate "..fixUsername(tgt.Name).." "..(t.Value-1)) end

        elseif name=="adall" then
            local interval, target = 1, sender
            for w in rawArgs:gmatch("%S+") do
                if tonumber(w) then interval=tonumber(w) else target=getTarget(w) or sender end
            end
            adallInterval,adallTarget,adallActive=interval,fixUsername(target.Name),true

        elseif name=="stopadall" then adallActive=false

        elseif name=="bots" then
            local n = tonumber(rawArgs)
            if n and n>0 then totalBots=n end

        elseif name=="botscheck" then sendChat(autoMatchMsg)

        elseif name=="mb" then
            if rawArgs~="" then autoMatchMsg=rawArgs; sendChat("Auto-match message set to: "..rawArgs)
            else autoMatchMsg="°"; sendChat("Auto-match message reset to °") end

        elseif name=="raidcalc" then
            local t       = getOwnTime()
            local needed  = math.max(0, 1000-(t and t.Value or 0))
            local seconds = math.ceil(needed/(totalBots+1))
            sendChat(("RaidCalc: %d minutes and %d seconds to reach 1000 time with %d total players."):format(
                math.floor(seconds/60), seconds%60, totalBots+1))

        elseif name=="orbitspeed" then
            local n = tonumber(rawArgs)
            if n and n~=0 then
                n = math.clamp(n, -50, 50)                       -- e.g. .orbitspeed 3, .orbitspeed 7, negative = reverse
                -- keep every bot's position continuous when the speed changes
                orbitAngle = orbitAngle + (orbitSpeed - n)*workspace:GetServerTimeNow()
                orbitSpeed = n
            end
            if messageToggles.orbitspeed then sendChat("orbitspeed set to ("..orbitSpeed..")") end

        elseif name=="prefix" then
            if rawArgs~="" then Prefix=rawArgs end

        elseif name=="antiafk" then
            pcall(function() loadstring(game:HttpGet("https://rawscripts.net/raw/Universal-Script-ANTI-AFK-by-gun-265109"))() end)
            if messageToggles.antiafk then sendChat("Anti-afk on") end

        elseif name=="antilag" then
            if lowerArgs=="off" then disableAntiLag(); if messageToggles.antilag then sendChat("Anti-lag off") end
            else applyAntiLag(); if messageToggles.antilag then sendChat("Anti-lag on") end end

        elseif name=="antigrief" then
            if lowerArgs=="off" then antiGriefEnabled=false; sendChat("Anti-grief off")
            else
                agTrackedParts = {}
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") then agTrackedParts[obj]=obj.Position end
                end
                antiGriefEnabled=true; sendChat("Anti-grief on")
            end

        elseif name=="animations" then
            setAnimationOverride(not animOverrideActive)

        elseif name=="mod" then
            local tgt = getTarget(rawArgs~="" and rawArgs or sender.Name)
            if not tgt then sendChat("Player not found"); return end
            if blacklist[tgt.UserId] then sendChat(tgt.Name.." is blacklisted"); return end
            ModUsers[tgt.UserId]=true
            sendChat("Modded "..tgt.Name)
            addLogEntry("[Mod] added "..tgt.Name)

        elseif name=="removemod" then
            if lowerArgs=="a" then ModUsers={}; sendChat("All mods removed")
            else
                local tgt = getTarget(rawArgs~="" and rawArgs or sender.Name)
                if tgt then
                    if ModUsers[tgt.UserId] then ModUsers[tgt.UserId]=nil; sendChat("Removed mod "..tgt.Name)
                    else sendChat(tgt.Name.." is not a mod") end
                else
                    sendChat("Player not found")
                end
            end

        elseif name=="cmds" then
            task.spawn(function()
                local SEP, LIMIT, DELAY = " | ", 105, 1.2
                local lines, current = {}, ""
                for cmd in allCommands:gmatch("%S+") do
                    if current == "" then
                        current = cmd
                    elseif #current + #SEP + #cmd <= LIMIT then
                        current = current .. SEP .. cmd
                    else
                        table.insert(lines, current)
                        current = cmd
                    end
                end
                if current ~= "" then table.insert(lines, current) end
                for i, line in ipairs(lines) do
                    sendChat(line)
                    if i < #lines then task.wait(DELAY) end
                end
            end)

        elseif name=="msgcmds" then
            sendChat("Usage: .msg <type> on/off | Types: loading, orbitspeed, formation, antiafk, antilag")

        elseif name=="msgcheck" then
            for k in pairs(defaultMessages) do
                sendChat(k.." | "..(messageToggles[k] and "on" or "off"))
                task.wait(0.2)
            end

        elseif name=="msg" then
            local a,b = rawArgs:match("^(%S+)%s+(%S+)$")
            a,b = a and a:lower(), b and b:lower()
            if a and defaultMessages[a]~=nil and (b=="on" or b=="off") then
                messageToggles[a]=(b=="on"); saveMessages(); sendChat("Message "..a.." "..b)
            else
                sendChat("Usage: .msg <type> on/off")
            end

        elseif name=="bully" then
            if not isOwner(sender) then return end
            local tgt = getTarget(rawArgs)
            if not tgt or isOwnerName(tgt.Name) then sendChat("Invalid target"); return end
            bullied[tgt.UserId] = true
            addLogEntry("[Bully] started on "..tgt.Name)
            task.spawn(doBully, tgt)

        elseif name=="unbully" then
            if not isOwner(sender) then return end
            local tgt = getTarget(rawArgs)
            if tgt then
                bullied[tgt.UserId] = nil
                sendChat("Unbullied "..tgt.Name)
                addLogEntry("[Bully] stopped for "..tgt.Name)
            end

        elseif name=="dance" then
            local arg = lowerArgs:match("^(%S+)")
            if not arg or arg=="off" or arg=="stop" then
                stopDance()
            else
                local n = tonumber(arg)
                if n and DANCES[n] then
                    task.spawn(startDance, n)
                    addLogEntry("[Dance] "..n..": "..DANCE_NAMES[n])
                    if slotNumber == 1 then sendChat("Dance "..n..": "..DANCE_NAMES[n]) end
                else sendChat("Usage: .dance 1-7 | .dance off") end
            end

        elseif name=="spydebug" then
            local parts = {}
            for k, v in pairs(spyInfo.counts) do parts[#parts+1] = k .. "=" .. v end
            table.sort(parts)
            addLogEntry("[SpyDebug] messages seen per source: " .. (#parts > 0 and table.concat(parts, "  ") or "none yet - say something in chat"), Color3.fromRGB(150,150,150))

        elseif name=="r6" then
            -- .R6 turns the guard on and it stays on; .R6 off to stop; .R6 now to fire once
            if lowerArgs=="now" then task.spawn(fireR6)
            elseif lowerArgs=="off" then setR6(false)
            else setR6(true) end

        elseif name=="dances" or name=="dsnces" then
            task.spawn(function()
                local lines = {}
                for i = 1, #DANCE_NAMES do lines[#lines+1] = ".dance "..i.." "..DANCE_NAMES[i] end
                local half = math.ceil(#lines/2)
                sendChat(table.concat(lines, " | ", 1, half))
                task.wait(1.2)
                sendChat(table.concat(lines, " | ", half+1, #lines))
            end)

        elseif name=="stopdance" then stopDance()

        elseif name=="autoclicker" then buildAutoclicker()
        elseif name=="keyboard"    then buildKeyboard()
        elseif name=="autobuild"   then buildAutobuildGui()
        end
    end

    local function safeProcess(sender, msg)
        local ok, err = pcall(processCommand, sender, msg)
        if not ok then addLogEntry("[Error] "..tostring(err), Color3.fromRGB(255,80,80)) end
    end

    -- every chat line goes through the gear check first, then command handling
    local function onChat(sender, msg)
        pcall(gearChatCheck, sender, msg)
        safeProcess(sender, msg)
    end

    local function hookPlayer(p)
        table.insert(allConnections, p.Chatted:Connect(function(m) onChat(p, m) end))
    end
    for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end
    table.insert(allConnections, Players.PlayerAdded:Connect(hookPlayer))
    if TextChatService then
        table.insert(allConnections, TextChatService.MessageReceived:Connect(function(m)
            local sender = m.TextSource and Players:GetPlayerByUserId(m.TextSource.UserId)
            if sender then onChat(sender, m.Text) end
        end))
    end

    _G.DuckywareLast = {}
    slotBox.Text = tostring(slotNumber)
    addLogEntry("Bot started | Owner: "..(hasOwner and ownerName or "anyone").." | Slot: "..slotNumber)

    logToDiscord("Script executed", {
        {name="Owner set", value=tostring(hasOwner and ownerName or "anyone"), inline=true},
        {name="Slot",      value=tostring(slotNumber),                         inline=true},
    }, 3066993)
end

