----------------------------------------------------------------------
-- Access lists (controlled from Discord through the hosted JSON)
----------------------------------------------------------------------
do
    local A = {whitelist = {}, blacklist = {}, mode = "open", loaded = false}
    K.Access = A

    local function norm(list)
        local out = {}
        for _, v in ipairs(type(list) == "table" and list or {}) do
            local n = tonumber(v)
            if n then out[n] = true else out[tostring(v):lower()] = true end
        end
        return out
    end
    local function listed(set, player)
        return set[player.UserId] == true or set[player.Name:lower()] == true
    end

    function A.isBlacklisted(player) return player ~= nil and listed(A.blacklist, player) end
    function A.isWhitelisted(player) return player ~= nil and listed(A.whitelist, player) end
    function A.canRun(player)
        if listed(A.blacklist, player) then return false end
        if A.mode == "whitelist" then return listed(A.whitelist, player) end
        return true
    end
    function A.refresh()
        if ACCESS_URL == "" or ACCESS_URL:find("YOUR_ACCESS", 1, true) then return false end
        local url = ACCESS_URL .. (ACCESS_URL:find("?", 1, true) and "&" or "?") .. "t=" .. os.time()
        local ok, body = pcall(function() return game:HttpGet(url) end)
        if not ok or type(body) ~= "string" then return false end
        local ok2, data = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok2 or type(data) ~= "table" then return false end
        A.blacklist = norm(data.blacklist)
        A.whitelist = norm(data.whitelist)
        A.mode = (data.mode == "whitelist") and "whitelist" or "open"
        A.loaded = true
        return true
    end
end

K.Access.refresh()
