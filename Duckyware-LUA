    local function getCirclePosition(root, slot, total, radius)
        local a = (2*math.pi*(slot-1))/total
        return root.CFrame * Vector3.new(math.cos(a)*radius, 0, math.sin(a)*radius)
    end

    local function getStarPosition(root, slot, total, size)
        local outer, inner, points = size, size*0.4, {}
        for i = 1, 10 do
            local a = math.pi/2 + (i-1)*(math.pi/5)
            points[i] = Vector3.new(math.cos(a)*(i%2==1 and outer or inner), 0, math.sin(a)*(i%2==1 and outer or inner))
        end
        local perimeter, dists = 0, {}
        for i = 1, #points do
            dists[i] = (points[i%#points+1]-points[i]).Magnitude
            perimeter += dists[i]
        end
        local target, acc = (slot-1)/total*perimeter, 0
        for i = 1, #points do
            if target <= acc+dists[i] then
                return root.CFrame * points[i]:Lerp(points[i%#points+1], (target-acc)/dists[i])
            end
            acc += dists[i]
        end
        return root.Position
    end

    local function createPlatform()
