----------------------------------------------------------------------
-- Anti-Grief (ported from the TCO anti-grief, with its options)
-- Watches for fast mass-deletion of someone's bricks, then (optionally)
--   * clears the griefer's inventory   (strip)
--   * rebuilds the deleted bricks      (autofix)
--   * says it in chat                  (warn)
-- Options: .griefset threshold|window|mintime <n>   autofix|strip|warn on/off
----------------------------------------------------------------------
do
    local E = K.Build
    local G = {active = false, gen = 0, queue = {}, cache = {}, conns = {}, pauseUntil = 0,
        cfg = {threshold = 5, window = 2, minTime = 60, autofix = true, strip = true, warn = false}}
    K.AntiGrief = G
    G.isProtected = function() return false end

    local function playerTime(name)
        local p = Players:FindFirstChild(name)
        local ls = p and p:FindFirstChild("leaderstats")
        local tv = ls and ls:FindFirstChild("Time")
        return tv and tv.Value or 0
    end
    local function medianTime()
        local times = {}
        for _, p in ipairs(Players:GetPlayers()) do
            local ls = p:FindFirstChild("leaderstats")
            local tv = ls and ls:FindFirstChild("Time")
            if tv then table.insert(times, tv.Value) end
        end
        if #times == 0 then return 0 end
        table.sort(times)
        return times[math.ceil(#times / 2)]
    end
    local function priority(bd) return (bd.sprays and #bd.sprays > 0) and 1 or 0 end

    local function findGriefer(center, victimName)
        local minDist, griefer = 60, nil
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name ~= victimName and p ~= LocalPlayer and not G.isProtected(p) then
                local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = (hrp.Position - center).Magnitude
                    if d < minDist then minDist, griefer = d, p end
                end
            end
        end
        return griefer
    end

    local function restoreBlocks(blocks, owner)
        table.sort(blocks, function(a, b) return priority(a) > priority(b) end)
        local t0 = os.clock()
        while E.busy and os.clock() - t0 < 60 and G.active do task.wait(0.5) end
        if not G.active then return end
        addLogEntry("[AntiGrief] rebuilding " .. #blocks .. " blocks for " .. owner)
        E.run(blocks, {label = "Auto-fix"})
    end

    local function ownerOf(bf, b)
        local p = b
        while p.Parent and p.Parent ~= bf do p = p.Parent end
        if p == b or not p.Parent then return nil end
        return p.Name
    end

    local function onRemoved(b)
        if not (b:IsA("BasePart") and b.Name == "Brick") then return end
        local owner = G.cache[b]; G.cache[b] = nil
        if not owner or os.clock() < G.pauseUntil then return end
        local ownerPlayer = Players:FindFirstChild(owner)
        if not ownerPlayer then return end            -- owner left: the server cleaned up, not grief
        local pos = b.Position
        local ohrp = ownerPlayer.Character and ownerPlayer.Character:FindFirstChild("HumanoidRootPart")
        if ohrp then
            local od = (ohrp.Position - pos).Magnitude
            if od < 20 then
                local closer = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= ownerPlayer and p ~= LocalPlayer then
                        local h = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                        if h and (h.Position - pos).Magnitude < od then closer = true; break end
                    end
                end
                if not closer then return end         -- owner deleting their own stuff
            end
        end
        local ok, bd = pcall(E.brickToBlock, b)
        if not ok or not bd then return end
        if #G.queue > 3000 then table.remove(G.queue, 1) end
        table.insert(G.queue, {time = os.clock(), owner = owner, block = bd, pos = pos})
    end

    local function evaluate()
        local now, c = os.clock(), G.cfg
        local fresh = {}
        for _, ev in ipairs(G.queue) do if now - ev.time <= 60 then fresh[#fresh + 1] = ev end end
        G.queue = fresh
        if now < G.pauseUntil then return end

        -- server wipe guard: huge burst across several owners is an admin clear, not a griefer
        local burst, owners, seen = 0, 0, {}
        for _, ev in ipairs(G.queue) do
            if now - ev.time <= 1 then
                burst += 1
                if not seen[ev.owner] then seen[ev.owner] = true; owners += 1 end
            end
        end
        if burst >= 150 and owners >= 3 then
            G.queue = {}; G.pauseUntil = now + 30
            addLogEntry("[AntiGrief] looks like a server wipe - ignoring for 30s")
            return
        end

        local byOwner = {}
        for _, ev in ipairs(G.queue) do
            if now - ev.time <= c.window then
                byOwner[ev.owner] = byOwner[ev.owner] or {}
                table.insert(byOwner[ev.owner], ev)
            end
        end
        for owner, events in pairs(byOwner) do
            if #events >= c.threshold then
                local victimTime, median = playerTime(owner), medianTime()
                local ratio = median > 0 and (victimTime / median) or 0
                local ignore = victimTime > 0 and victimTime < c.minTime and ratio < 0.3

                local restore, rest = {}, {}
                local sx, sy, sz, n = 0, 0, 0, 0
                for _, ev in ipairs(G.queue) do
                    if ev.owner == owner then
                        restore[#restore + 1] = ev.block
                        sx += ev.pos.X; sy += ev.pos.Y; sz += ev.pos.Z; n += 1
                    else
                        rest[#rest + 1] = ev
                    end
                end
                G.queue = rest

                if not ignore and n > 0 then
                    local griefer = findGriefer(Vector3.new(sx / n, sy / n, sz / n), owner)
                    local gname = griefer and griefer.Name or ""
                    if c.strip and gname ~= "" then sendRaw(";clearinv " .. chatName(gname)) end
                    if c.warn then
                        sendRaw((gname ~= "" and gname or "someone") .. " HAS BEEN DETECTED GRIEFING " .. owner .. "'s build")
                    end
                    addLogEntry("[AntiGrief] " .. owner .. " lost " .. #restore .. " blocks" .. (gname ~= "" and (" - suspect: " .. gname) or ""))
                    if c.autofix then task.spawn(restoreBlocks, restore, owner) end
                end
            end
        end
    end

    function G.stop()
        G.active = false
        G.gen += 1
        for _, cn in ipairs(G.conns) do pcall(function() cn:Disconnect() end) end
        G.conns, G.queue, G.cache = {}, {}, {}
    end

    function G.start()
        G.stop()
        local bf = workspace:FindFirstChild("Bricks")
        if not bf then return false end
        G.active = true
        local gen = G.gen
        for _, b in ipairs(bf:GetDescendants()) do
            if b:IsA("BasePart") and b.Name == "Brick" then
                local o = ownerOf(bf, b)
                if o then G.cache[b] = o end
            end
        end
        table.insert(G.conns, bf.DescendantAdded:Connect(function(b)
            if b:IsA("BasePart") and b.Name == "Brick" then
                local o = ownerOf(bf, b)
                if o then G.cache[b] = o end
            end
        end))
        table.insert(G.conns, bf.DescendantRemoving:Connect(onRemoved))
        table.insert(G.conns, Players.PlayerRemoving:Connect(function(p)
            local keep = {}
            for _, ev in ipairs(G.queue) do if ev.owner ~= p.Name then keep[#keep + 1] = ev end end
            G.queue = keep
        end))
        task.spawn(function()
            while G.active and G.gen == gen do
                task.wait(0.3)
                pcall(evaluate)
            end
        end)
        return true
    end

    local function onOff(v)
        v = tostring(v or ""):lower()
        if v == "on" or v == "true" or v == "yes" then return true end
        if v == "off" or v == "false" or v == "no" then return false end
        return nil
    end

    function G.summary()
        local c = G.cfg
        return ("Anti-grief %s | threshold %d | window %ss | mintime %ds | autofix %s | strip %s | warn %s"):format(
            G.active and "ON" or "off", c.threshold, tostring(c.window), c.minTime,
            c.autofix and "on" or "off", c.strip and "on" or "off", c.warn and "on" or "off")
    end

    function G.set(opt, val)
        opt = tostring(opt or ""):lower()
        local c, n = G.cfg, tonumber(val)
        if opt == "threshold" and n then c.threshold = math.clamp(math.floor(n), 2, 100)
        elseif opt == "window" and n then c.window = math.clamp(n, 0.5, 15)
        elseif opt == "mintime" and n then c.minTime = math.max(0, n)
        elseif (opt == "autofix" or opt == "strip" or opt == "warn") and onOff(val) ~= nil then c[opt] = onOff(val)
        else return false, "Usage: .griefset threshold|window|mintime <n> or autofix|strip|warn on/off" end
        return true, G.summary()
    end
end

