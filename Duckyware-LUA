local autoclickerGui, autoclickerOn, autoclickerCPS = nil, false, 10

local function buildAutoclicker()
    if autoclickerGui then autoclickerGui.Enabled = not autoclickerGui.Enabled; return end
    autoclickerGui = newGui("KokuAutoclicker")
    local frame, title = makePanel(autoclickerGui, UDim2.fromOffset(240, 185),
        UDim2.new(0, 10, 0, 10), Vector2.new(0, 0), "AUTOCLICKER")
    draggable(title, frame)

    local reticleHolder = Instance.new("Frame", frame)
    reticleHolder.Size = UDim2.new(1, -24, 0, 72)
    reticleHolder.Position = UDim2.fromOffset(12, 44)
    reticleHolder.BackgroundColor3 = BLACK
    reticleHolder.BorderSizePixel = 0
    squircle(reticleHolder, 10)
    outline(reticleHolder, 1)
    makeLabel(reticleHolder, "Drag or tap here to place click point",
        UDim2.new(1, -8, 0, 16), UDim2.new(0.5, 0, 0, 4), 10)

    local reticle = Instance.new("Frame", reticleHolder)
    reticle.Size = UDim2.fromOffset(26, 26)
    reticle.AnchorPoint = Vector2.new(0.5, 0.5)
    reticle.Position = UDim2.new(0.5, 0, 0.6, 0)
    reticle.BackgroundColor3 = GREEN
    squircle(reticle, 13)

    local function placeAt(pos)
        local rel = pos - reticleHolder.AbsolutePosition
        local x = math.clamp(rel.X, 0, reticleHolder.AbsoluteSize.X)
        local y = math.clamp(rel.Y, 0, reticleHolder.AbsoluteSize.Y)
        reticle.Position = UDim2.new(0, x, 0, y)
    end

    local draggingR = false
    reticle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then draggingR = true end
    end)
    reticleHolder.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            draggingR = true; placeAt(i.Position)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if draggingR and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then placeAt(i.Position) end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then draggingR = false end
    end)

    local cpsBox    = makeBox(frame, UDim2.fromOffset(80, 30), UDim2.fromOffset(12, 125), tostring(autoclickerCPS), "CPS", Vector2.new(0,0))
    local toggleBtn = makeButton(frame, "Start", UDim2.fromOffset(120, 30), UDim2.new(1,-12,0,125), true, Vector2.new(1,0))
    local closeBtn2 = makeButton(frame, "Close", UDim2.fromOffset(60, 22), UDim2.new(0.5,0,1,-30), false)

    cpsBox.FocusLost:Connect(function()
        local n = tonumber(cpsBox.Text)
        if n and n > 0 then autoclickerCPS = n end
    end)

    local VIM = game:GetService("VirtualInputManager")
    toggleBtn.MouseButton1Click:Connect(function()
        autoclickerOn = not autoclickerOn
        toggleBtn.Text = autoclickerOn and "Stop" or "Start"
        if autoclickerOn then
            task.spawn(function()
                while autoclickerOn and autoclickerGui and autoclickerGui.Parent do
                    local abs, size = reticle.AbsolutePosition, reticle.AbsoluteSize
                    local x, y = abs.X + size.X / 2, abs.Y + size.Y / 2
                    pcall(function()
                        VIM:SendMouseButtonEvent(x, y, 0, true,  game, 0)
                        VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
                    end)
                    task.wait(1 / math.max(autoclickerCPS, 1))
                end
            end)
        end
    end)
    closeBtn2.MouseButton1Click:Connect(function()
        autoclickerOn = false
        autoclickerGui.Enabled = false
    end)
end

