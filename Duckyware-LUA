    local function startToolForcing()
        isBuildingAB = true
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if LocalPlayer.Character and bp then
            for _, tool in pairs(bp:GetChildren()) do
                if tool:IsA("Tool") and TOOL_NAMES[tool.Name] then tool.Parent = LocalPlayer.Character end
            end
        end
        if toolEquipConn then toolEquipConn:Disconnect() end
        if bp then
            toolEquipConn = bp.ChildAdded:Connect(function(tool)
                if not isBuildingAB then return end
                if tool:IsA("Tool") and TOOL_NAMES[tool.Name] then
                    task.wait(0.01)
                    if LocalPlayer.Character and tool.Parent==bp then tool.Parent=LocalPlayer.Character end
                end
            end)
        end
    end
    local function stopToolForcing()
        isBuildingAB = false
        if toolEquipConn then toolEquipConn:Disconnect(); toolEquipConn = nil end
    end

    local positionLock = nil
    local function lockPosition(targetPos)
        if positionLock then positionLock:Disconnect() end
        positionLock = RunService.Heartbeat:Connect(function()
            local hrp = getHRP()
            if hrp then
                hrp.CFrame = CFrame.new(targetPos)
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    end
    local function unlockPosition() if positionLock then positionLock:Disconnect(); positionLock=nil end end

    local function findBlockNear(targetPos, radius)
        local pf = getPlayerBricksFolder(); if not pf then return nil end
        local best, bestDist = nil, radius or 1
        for _, b in pairs(pf:GetChildren()) do
            if b:IsA("BasePart") and b.Name=="Brick" then
                local d = (b.Position-targetPos).Magnitude
                if d < bestDist then best,bestDist=b,d end
            end
        end
        return best
    end
    local function getCornerPosition(centerPos, size)
        local h = size/2
        return Vector3.new(centerPos.X-h.X+0.5, centerPos.Y-h.Y+0.5, centerPos.Z-h.Z+0.5)
    end

    local function paintBlockAB(brick, color, material)
        local pt  = findToolByName("Paint")
        local hrp = getHRP()
        if not (pt and hrp) then return false end
        local mname = MaterialToPaintName[material] or "smooth"
        for _ = 1, 2 do
            pcall(function() pt.event:FireServer(brick, Enum.NormalId.Left, hrp.Position, "both", color, mname, "") end)
            task.wait(0.05)
        end
        return true
    end
    local function sprayBlockAB(brick, face, text, colorHex)
        local pt  = findToolByName("Paint")
        local hrp = getHRP()
        if not (pt and hrp) then return false end
        pcall(function() pt.event:FireServer(brick, face, hrp.Position, "both", hexToColor(colorHex), "spray", text) end)
        return true
    end

    local function resizeBlockAB(brick, targetSize)
        local st  = findToolByName("Shape")
        local hrp = getHRP()
        if not (st and brick and hrp) then return false end
        local pos = hrp.Position
        local rightN = math.floor(targetSize.X-1)
        local topN   = math.floor(targetSize.Y-1)
        local backN  = math.floor(targetSize.Z-1)
        for i = 1, math.max(rightN, topN, backN) do
            local b = getNewestBrick(); if not b then return false end
            if i<=rightN then pcall(function() st.event:FireServer(b,Enum.NormalId.Right,pos,"increase") end); task.wait(0.07) end
            b = getNewestBrick(); if not b then return false end
            if i<=topN   then pcall(function() st.event:FireServer(b,Enum.NormalId.Top,  pos,"increase") end); task.wait(0.07) end
            b = getNewestBrick(); if not b then return false end
            if i<=backN  then pcall(function() st.event:FireServer(b,Enum.NormalId.Back, pos,"increase") end); task.wait(0.07) end
        end
        return true
    end

    -- returns blocks, originalCenter
    local function parseBlocksAB(buildStr, centerCF)
        local raw, totalPos = {}, Vector3.new()
        for blockData in buildStr:gmatch("|([^|]+)") do
            local colorHex       = blockData:sub(1,6)
            local materialSymbol = blockData:sub(7,7)
            local rest           = blockData:sub(8)
            local canCollide     = true
            if rest:sub(1,1)=="^" then canCollide=false; rest=rest:sub(2) end
            local sizeData, posData, extraData = rest:match("^([%d,]+)%.([%-%.%d,]+)%.?(.*)")
            if sizeData and posData and colorHex:match("^%x%x%x%x%x%x$") then
                local sx,sy,sz = sizeData:match("(%d+),(%d+),(%d+)")
                local px,py,pz = posData:match("(%-?%d+%.?%d*),(%-?%d+%.?%d*),(%-?%d+%.?%d*)")
                if sx and px then
                    local rSize = Vector3.new(tonumber(sx),tonumber(sy),tonumber(sz))
                    local rPos  = Vector3.new(tonumber(px),tonumber(py),tonumber(pz))
                    totalPos   += rPos
                    local sprays = {}
                    if extraData and extraData~="" then
                        local fm = {L=Enum.NormalId.Left,R=Enum.NormalId.Right,T=Enum.NormalId.Top,
                            Bo=Enum.NormalId.Bottom,F=Enum.NormalId.Front,Ba=Enum.NormalId.Back}
                        for face, text, color in extraData:gmatch('(%a+)"([^"]*)""([^"]*)"') do
                            if fm[face] and #color == 6 then table.insert(sprays,{face=fm[face],text=text,colorHex=color}) end
                        end
                    end
                    table.insert(raw,{rawSize=rSize,rawPos=rPos,color=hexToColor(colorHex),
                        material=SymbolToMaterial[materialSymbol] or Enum.Material.SmoothPlastic,
                        canCollide=canCollide,sprays=sprays})
                end
            end
        end
        if #raw==0 then return {}, nil end
        local originalCenter = snapGrid(totalPos/#raw)
        local targetCF = centerCF or CFrame.new(originalCenter)
        local rotOnly  = targetCF - targetCF.Position
        local blocks   = {}
        for _, r in ipairs(raw) do
            local centerPos = (targetCF * CFrame.new(r.rawPos - originalCenter)).Position
            local size      = transformSize(r.rawSize, rotOnly)
            local is4       = (size == Vector3.new(4,4,4))
            local function mod4(n) return ((n%4)+4)%4 end
            local onGrid = (math.abs(mod4(centerPos.X)-2)<0.01)
                       and (math.abs(mod4(centerPos.Y)-2)<0.01)
                       and (math.abs(mod4(centerPos.Z)-2)<0.01)
            local sprays = {}
            for _, s in ipairs(r.sprays) do
                table.insert(sprays,{face=transformNormalId(s.face,rotOnly),text=s.text,colorHex=s.colorHex})
            end
            table.insert(blocks,{size=size,centerPos=centerPos,color=r.color,material=r.material,
                canCollide=r.canCollide,needsResize=not(is4 and onGrid),sprays=sprays})
        end
        return blocks, originalCenter
    end

    local function placeBlockAB(blockData)
        local bt = findToolByName("Build")
        if not bt then return false end
        local tpPos = blockData.needsResize and getCornerPosition(blockData.centerPos,blockData.size) or blockData.centerPos
        lockPosition(tpPos + Vector3.new(0,12,0))
        if findBlockNear(blockData.centerPos, 1) then return true end -- already built
        task.wait(0.03)
        local placePos  = blockData.needsResize and getCornerPosition(blockData.centerPos,blockData.size) or blockData.centerPos
        local placeMode = not blockData.canCollide
            and (blockData.needsResize and "detailed nocollide" or "nocollide")
            or  (blockData.needsResize and "detailed" or "normal")
        local initial    = getBrickCount()
        local retryDelay = blockData.canCollide and 0.05 or 0.2
        pcall(function() bt.event:FireServer(workspace.Terrain, Enum.NormalId.Top, placePos, placeMode) end)
        local attempts = 0
        while getBrickCount()==initial and attempts<40 do
            task.wait(retryDelay); attempts+=1
            pcall(function() bt.event:FireServer(workspace.Terrain, Enum.NormalId.Top, placePos, placeMode) end)
        end
        if getBrickCount()==initial then return false end
        local newBrick = getNewestBrick(); if not newBrick then return false end
        task.wait(0.02)
        paintBlockAB(newBrick, blockData.color, blockData.material)
        for _, spray in ipairs(blockData.sprays or {}) do
            task.wait(0.03)
            sprayBlockAB(newBrick, spray.face, spray.text, spray.colorHex)
        end
        if blockData.needsResize and blockData.size ~= Vector3.new(1,1,1) then
            task.wait(0.02)
            resizeBlockAB(newBrick, blockData.size)
        end
        return true
    end

    local function getNearestUnbuiltIndex(blocks, done, hrp)
        local bestI, bestD = nil, math.huge
        for i, b in ipairs(blocks) do
            if not done[i] then
                local d = (hrp.Position - b.centerPos).Magnitude
                if d < bestD then bestD,bestI=d,i end
            end
        end
        return bestI
    end

    local stopBuildAB, building = false, false
    local buildCF = nil

    local function finishBuild()
        unlockPosition(); stopToolForcing(); disableBuildNoclip()
    end

    local function runAutoBuild(buildString, centerCF)
        local blocks = parseBlocksAB(buildString, centerCF)
        if #blocks==0 then setStatus("No valid blocks in text"); return end
        local missing = missingTools()
        if #missing>0 then setStatus("Missing tool: "..table.concat(missing, ", ")); return end
        startToolForcing()
        enableBuildNoclip()
        local done, fails = {}, {}
        local total, finished, skipped = #blocks, 0, 0
        while finished < total do
            if stopBuildAB then break end
            local hrp = getHRP()
            if not hrp then
                task.wait(0.5) -- dead / respawning
            else
                if #missingTools() > 0 then setStatus("Tool lost - stopped"); break end
                local i = getNearestUnbuiltIndex(blocks, done, hrp)
                if not i then break end
                if placeBlockAB(blocks[i]) then
                    done[i] = true; finished += 1
                else
                    fails[i] = (fails[i] or 0) + 1
                    if fails[i] >= 3 then done[i] = true; finished += 1; skipped += 1 end
                end
                unlockPosition()
                setStatus("Building "..finished.."/"..total..(skipped>0 and (" ("..skipped.." skipped)") or ""))
                task.wait(0.03)
            end
        end
        finishBuild()
        if stopBuildAB then setStatus("Stopped at "..finished.."/"..total)
        elseif statusMsg:sub(1,4) == "Tool" then -- keep the tool message
        else setStatus("Done "..(total-skipped).."/"..total) end
    end

