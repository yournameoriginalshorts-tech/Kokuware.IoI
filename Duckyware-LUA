    ----------------------------------------------------------------
    -- Anti-crash (local) + Anti-clone (.anticlone)
    -- Anti-crash: deletes any instance named "clone" that isn't a
    --   character, on your client.
    -- Anti-clone: finds clone rigs of players (named "clone", or named
    --   like a player but not their real character), flings them with a
    --   fast spin so they leave the map, then removes them locally.
    ----------------------------------------------------------------
    local antiCrashOn  = true
    local antiCloneOn  = false
    local cloneQueue, cloneQueued = {}, {}

    local function isPlayerCharacter(obj)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character and (plr.Character==obj or obj:IsDescendantOf(plr.Character)) then return true end
        end
        return false
    end

    local function looksLikeClone(obj)
        if not obj or not obj.Parent or not obj:IsA("Model") then return false end
        if not obj:FindFirstChildOfClass("Humanoid") then return false end
        if isPlayerCharacter(obj) then return false end
        local n = obj.Name:lower()
        if n:find("clone", 1, true) then return true end
        for _, plr in ipairs(Players:GetPlayers()) do
            if n == plr.Name:lower() or n == plr.DisplayName:lower() then return true end
        end
        return false
    end

    local function queueClone(rig)
        if cloneQueued[rig] then return end
        cloneQueued[rig] = true
        table.insert(cloneQueue, rig)
    end

    local function flingClone(rig)
        local char = LocalPlayer.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local root = rig:FindFirstChild("HumanoidRootPart") or rig.PrimaryPart or rig:FindFirstChildWhichIsA("BasePart", true)
        if not (hrp and root) then return end
        local saved = hrp.CFrame
        local t0 = os.clock()
        while os.clock()-t0 < 1.5 and antiCloneOn and root.Parent and hrp.Parent do
            hrp.CanCollide = true
            hrp.CFrame = root.CFrame
            hrp.AssemblyAngularVelocity = Vector3.new(0, 9000, 0)
            hrp.AssemblyLinearVelocity  = Vector3.new(9000, 9000, 9000)
            pcall(function() root.AssemblyLinearVelocity = Vector3.new(0, 50000, 0) end)
            RunService.Heartbeat:Wait()
        end
        if hrp.Parent then
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.CFrame = saved
        end
    end

    local function removeClone(obj)
        if not antiCrashOn or not obj or not obj.Parent then return end
        if not string.find(obj.Name:lower(), "clone", 1, true) then return end
        if isPlayerCharacter(obj) then return end
        if antiCloneOn then
            -- let the anti-clone queue fling rigs before they're deleted
            local rig = obj:IsA("Model") and obj or obj:FindFirstAncestorOfClass("Model")
            if rig and rig:FindFirstChildOfClass("Humanoid") then return end
        end
        pcall(function() obj:Destroy() end)
    end
    task.spawn(function() for _, obj in ipairs(workspace:GetDescendants()) do removeClone(obj) end end)
    table.insert(allConnections, workspace.DescendantAdded:Connect(removeClone))

    table.insert(allConnections, workspace.DescendantAdded:Connect(function(obj)
        if not antiCloneOn or not obj:IsA("Model") then return end
        task.delay(0.2, function()
            if antiCloneOn and looksLikeClone(obj) then queueClone(obj) end
        end)
    end))

    task.spawn(function()
        while myGen==_G.DuckywareGen do
            if antiCloneOn and #cloneQueue>0 and not hiding then
                local rig = table.remove(cloneQueue, 1)
                cloneQueued[rig] = nil
                if rig and rig.Parent and looksLikeClone(rig) then
                    local nm = rig.Name
                    pcall(flingClone, rig)
                    pcall(function() rig:Destroy() end)
                    addLogEntry("[AntiClone] flung clone: " .. nm)
                end
            else
                task.wait(0.2)
            end
        end
    end)

    -- Anti-grief detection (OFF by default, use .antigrief on)
    local AG_SCAN_INTERVAL   = 0.05
    local AG_GRIEF_TIME      = 0.85
    local AG_MAX_GAP         = 0.30
    local AG_DETECT_DISTANCE = 50
    local AG_MIN_DELETIONS   = 2
    local AG_WARN_COOLDOWN   = 30
    local agTrackedParts, agPlayerData, agLastWarnings = {}, {}, {}
    local antiGriefEnabled = false

    local function agIsDeleteTool(tool)
        if not tool:IsA("Tool") then return false end
        local n = tool.Name:lower():gsub("%s+","")
        return n=="dtool" or n=="deletetool" or n:find("delete",1,true) or n:find("dtool",1,true)
    end
    local function agHoldingDeleteTool(player)
        local char = player.Character; if not char then return false end
        for _, obj in ipairs(char:GetChildren()) do if agIsDeleteTool(obj) then return true end end
        return false
    end
    local function agGetClosestDToolPlayer(position)
        local closest, closestDist = nil, AG_DETECT_DISTANCE
        for _, player in ipairs(Players:GetPlayers()) do
            if agHoldingDeleteTool(player) then
                local char = player.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    local dist = (root.Position-position).Magnitude
                    if dist<=closestDist then closestDist=dist; closest=player end
                end
            end
        end
        return closest
    end
    local function agRecordDeletion(player)
        if not agPlayerData[player] then agPlayerData[player]={deletions={},streakStart=nil,lastDeletion=nil} end
        local data = agPlayerData[player]; local now = os.clock()
        table.insert(data.deletions, now)
        if data.lastDeletion and (now-data.lastDeletion)>AG_MAX_GAP then data.deletions={now}; data.streakStart=nil end
        data.lastDeletion = now
        if not data.streakStart and #data.deletions>=AG_MIN_DELETIONS then data.streakStart=now end
    end
    local function agScanWorkspace()
        local current = {}
        for _, obj in ipairs(workspace:GetDescendants()) do if obj:IsA("BasePart") then current[obj]=obj.Position end end
        for oldPart, oldPos in pairs(agTrackedParts) do
            if not current[oldPart] then
                local player = agGetClosestDToolPlayer(oldPos)
                if player then agRecordDeletion(player) end
            end
        end
        agTrackedParts = current
    end
    local function agCheckPlayers()
        local now = os.clock()
        for player, data in pairs(agPlayerData) do
            if not player.Parent then agPlayerData[player]=nil; agLastWarnings[player]=nil; continue end
            if not data.lastDeletion then continue end
            if (now-data.lastDeletion)>AG_MAX_GAP then
                data.streakStart=nil; data.deletions={}; data.lastDeletion=nil; continue
            end
            if data.streakStart and (now-data.streakStart)>=AG_GRIEF_TIME then
                local lastWarn = agLastWarnings[player] or 0
                if now-lastWarn>=AG_WARN_COOLDOWN then
