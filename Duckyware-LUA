----------------------------------------------------------------------
-- Chat spy
-- Sources: Player.Chatted, TextChatService.MessageReceived, the legacy
-- chat event, and every RemoteEvent in ReplicatedStorage.
-- Duplicates of the same message are merged.
----------------------------------------------------------------------
local spyAlive = true
local spyMode  = "all"          -- "all" = every chat message, "cmds" = only ; commands (.logmode)
local spySeen, spySeenText = {}, {}
local spyInfo = {counts = {}, hooks = {}}
local selfSent = {}             -- messages this script sent itself (so bot spam isn't logged)

local lastLogToggle = 0
local function toggleLogs()
    if not logGui or not logGui.Parent then return end
    if os.clock() - lastLogToggle < 0.6 then return end
    lastLogToggle = os.clock()
    logGui.Enabled = not logGui.Enabled
end
local function checkLogsCmd(text)
    if type(text) == "string" and text:lower():match("^%s*[%.;]logs%s*$") then toggleLogs() end
end

local function spyRecord(name, text, isCmd)
    if isCmd then
        pcall(function()
            local line = string.format('<font color="#00E66E">[Spy] %s: %s</font>', name, text)
            if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                local ch = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
                if ch then ch:DisplaySystemMessage(line) end
            else
                game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", {
                    Text = "[Spy] " .. name .. ": " .. text, Color = Color3.fromRGB(0, 230, 110),
                })
            end
        end)
        addLogEntry("[Spy] " .. name .. ": " .. text)
    else
        addLogEntry(name .. ": " .. text, Color3.fromRGB(225, 225, 225))
    end
end

local function SpyOnMessage(sender, text, fallbackName, source)
    if not spyAlive or type(text) ~= "string" then return end
    source = source or "?"
    spyInfo.counts[source] = (spyInfo.counts[source] or 0) + 1
    text = text:gsub("^%s+", "")
    if text == "" then return end
    if sender and _G.KokuwareR6Hook then pcall(_G.KokuwareR6Hook, sender, text) end
    local isCmd = text:sub(1, 1) == ";"
    if spyMode == "cmds" and not isCmd then return end
    local now = os.clock()
    if sender == LocalPlayer then
        local t = selfSent[text]
        if t and now - t < 5 then return end
    end
    if sender then
        local key = sender.UserId .. ":" .. text
        if spySeen[key] and now - spySeen[key] < 1 then return end
        spySeen[key] = now
        spySeenText[text] = now
        spyRecord(sender == LocalPlayer and "you" or sender.Name, text, isCmd)
    else
        task.delay(0.5, function()
            local t = spySeenText[text]
            if t and os.clock() - t < 1.5 then return end
            spySeenText[text] = os.clock()
            spyRecord(fallbackName or "?", text, isCmd)
        end)
    end
end

local function handleTextMessage(m, source)
    local src = m and m.TextSource
    if not src then return end
    local sender = Players:GetPlayerByUserId(src.UserId)
    if sender then
        if sender == LocalPlayer then checkLogsCmd(m.Text) end
        SpyOnMessage(sender, m.Text, nil, source)
    end
end

if TextChatService then
    spyInfo.hooks.MessageReceived = pcall(function()
        TextChatService.MessageReceived:Connect(function(m) handleTextMessage(m, "MessageReceived") end)
    end)
    spyInfo.hooks.Channels = pcall(function()
        local function hookChannel(ch)
            if ch:IsA("TextChannel") then
                pcall(function() ch.MessageReceived:Connect(function(m) handleTextMessage(m, "Channel") end) end)
