    -- knownBots; BOT_NAMES is the always-on fallback list.
    ----------------------------------------------------------------
    local function isBotName(name)
        if knownBots[name] then return true end
        for _, n in ipairs(BOT_NAMES) do
            if n:lower() == name:lower() then return true end
        end
        return false
    end

    local function getSignIndex()
        local roster = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer or isBotName(plr.Name) then
