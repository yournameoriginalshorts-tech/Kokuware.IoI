-- Credits: Kokushibo / haise
-- This file is the same hub as KOKUWAREHUB.TXT, stored as encoded text and run at load time.
local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local DEC = {}
for i = 1, 64 do DEC[B64:byte(i)] = i - 1 end

local function unpackText(s)
    s = s:gsub("[^%w%+/]", "")
    local out, n = {}, 0
    for i = 1, #s, 4 do
        local a = DEC[s:byte(i)]
        local b = DEC[s:byte(i + 1)]
        local c = DEC[s:byte(i + 2)]
        local d = DEC[s:byte(i + 3)]
        local v = (a or 0) * 262144 + (b or 0) * 4096 + (c or 0) * 64 + (d or 0)
        n = n + 1; out[n] = string.char(math.floor(v / 65536) % 256)
        if c then n = n + 1; out[n] = string.char(math.floor(v / 256) % 256) end
        if d then n = n + 1; out[n] = string.char(v % 256) end
    end
    return table.concat(out)
end

local PAYLOAD = [==[]==]

local source = unpackText(PAYLOAD)
local fn, err = loadstring(source, "=KokuwareHUB")
if not fn then
    error("Kokuware hub failed to compile: " .. tostring(err), 0)
end
return fn()
