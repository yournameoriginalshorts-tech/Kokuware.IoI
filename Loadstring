do
    local AL = {saved = setmetatable({}, {__mode = "k"}), conns = {}, active = false, max = false, id = 0, render3d = true}
    K.AntiLag = AL

    local function setProp(inst, prop, val)
        pcall(function()
            local t = AL.saved[inst]
            if not t then t = {}; AL.saved[inst] = t end
            if t[prop] == nil then t[prop] = inst[prop] end
            inst[prop] = val
        end)
    end

    local function isMine(d)
        local ch = LocalPlayer.Character
        return ch ~= nil and d:IsDescendantOf(ch)
    end

    local function strip(d)
        if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Smoke") or d:IsA("Fire")
            or d:IsA("Sparkles") or d:IsA("Highlight") or d:IsA("Light") then
            if AL.max then pcall(d.Destroy, d) else setProp(d, "Enabled", false) end
        elseif d:IsA("Explosion") then
            setProp(d, "Visible", false)
        elseif d:IsA("Decal") or d:IsA("Texture") then
            if not isMine(d) then
                if AL.max then pcall(d.Destroy, d) else setProp(d, "Transparency", 1) end
            end
        elseif d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
            setProp(d, "Enabled", false)
        elseif d:IsA("ForceField") then
            setProp(d, "Visible", false)
        elseif d:IsA("SurfaceAppearance") or d:IsA("MaterialVariant") then
            if AL.max then pcall(d.Destroy, d) end
        elseif d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") or d:IsA("CharacterMesh") then
            if AL.max and not isMine(d) then pcall(d.Destroy, d) end
        elseif d:IsA("Terrain") then
            return
        elseif d:IsA("BasePart") then
            setProp(d, "CastShadow", false)
            setProp(d, "Reflectance", 0)
            if d:IsA("MeshPart") then
                setProp(d, "RenderFidelity", Enum.RenderFidelity.Performance)
                if AL.max then pcall(function() d.TextureID = "" end) end
            end
            if AL.max and not isMine(d) then
                setProp(d, "Transparency", 1)
                setProp(d, "Material", Enum.Material.SmoothPlastic)
            end
        end
    end

    local function sweep(myId)
        local list = workspace:GetDescendants()
        local last = os.clock()
        for i = 1, #list do
            if not AL.active or AL.id ~= myId then return end
            strip(list[i])
            if i % 200 == 0 and os.clock() - last > 0.004 then task.wait(); last = os.clock() end
        end
    end

    local function worldSettings()
        local L = game:GetService("Lighting")
        setProp(L, "GlobalShadows", false)
        setProp(L, "ShadowSoftness", 0)
        setProp(L, "Technology", Enum.Technology.Compatibility)
        setProp(L, "EnvironmentDiffuseScale", 0)
        setProp(L, "EnvironmentSpecularScale", 0)
        setProp(L, "FogEnd", 9e9)
        for _, d in ipairs(L:GetDescendants()) do
            if d:IsA("PostEffect") then setProp(d, "Enabled", false)
            elseif d:IsA("Atmosphere") then setProp(d, "Density", 0); setProp(d, "Haze", 0)
            elseif d:IsA("Sky") then
                if AL.max then pcall(d.Destroy, d) else setProp(d, "StarCount", 0) end
            end
        end
        local T = workspace:FindFirstChildOfClass("Terrain")
        if T then
            setProp(T, "WaterWaveSize", 0); setProp(T, "WaterWaveSpeed", 0)
            setProp(T, "WaterReflectance", 0); setProp(T, "Decoration", false)
            for _, c in ipairs(T:GetChildren()) do if c:IsA("Clouds") then setProp(c, "Enabled", false) end end
        end
        pcall(function() settings().Physics.AllowSleep = true end)
        pcall(function() game:GetService("SoundService").AmbientReverb = Enum.ReverbType.NoReverb end)
        pcall(function()
            local R = settings().Rendering
            if AL.oldQuality == nil then AL.oldQuality = R.QualityLevel end
            R.QualityLevel = Enum.QualityLevel.Level01
            R.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04
        end)
        if AL.max then
            pcall(function()
                for _, v in ipairs(game:GetService("MaterialService"):GetChildren()) do v:Destroy() end
            end)
        end
    end

    function AL.off()
        if not AL.active then
            if not AL.render3d then AL.set3D(true) end
            return
        end
        AL.active = false
        AL.id += 1
        for _, c in ipairs(AL.conns) do pcall(function() c:Disconnect() end) end
        AL.conns = {}
        for inst, props in pairs(AL.saved) do
            for prop, val in pairs(props) do pcall(function() inst[prop] = val end) end
        end
        AL.saved = setmetatable({}, {__mode = "k"})
        pcall(function()
            if AL.oldQuality ~= nil then settings().Rendering.QualityLevel = AL.oldQuality end
            AL.oldQuality = nil
        end)
        if not AL.render3d then AL.set3D(true) end
        addLogEntry("[AntiLag] off" .. (AL.max and " (destroyed textures need a rejoin)" or ""))
    end

    function AL.on(maxMode)
        maxMode = maxMode and true or false
        if AL.active then
            if AL.max == maxMode then return end
            AL.off()
        end
        AL.active = true
        AL.max = maxMode
        AL.id += 1
        local myId = AL.id
        worldSettings()
        task.spawn(sweep, myId)
        task.spawn(function()
            while AL.active and AL.id == myId do
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character then
                        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                        if hum then
                            pcall(function() hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end)
                            local an = hum:FindFirstChildOfClass("Animator")
                            if an then
                                for _, t in ipairs(an:GetPlayingAnimationTracks()) do pcall(function() t:Stop(0) end) end
                            end
                        end
                    end
                end
                task.wait(1)
            end
        end)
        AL.conns[#AL.conns + 1] = workspace.DescendantAdded:Connect(function(d)
            if AL.active then strip(d) end
        end)
        task.spawn(function()
            while AL.active and AL.id == myId do
                pcall(collectgarbage, "collect")
                task.wait(20)
            end
        end)
        addLogEntry("[AntiLag] " .. (maxMode and "MAX" or "normal") .. " mode on - KokuAntiLag, credits to Kokushibo/haise")
        notify("KokuAntiLag", (maxMode and "MAX" or "Normal") .. " mode on. Made by Kokushibo.", 5)
    end

    function AL.set3D(enabled)
        AL.render3d = enabled and true or false
        pcall(function() RunService:Set3dRenderingEnabled(AL.render3d) end)
        pcall(function() if setfpscap then setfpscap(AL.render3d and 60 or 15) end end)
        addLogEntry("[AntiLag] 3D rendering " .. (AL.render3d and "on" or "off"))
    end
end

