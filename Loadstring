        end

        function W.progress()
            local bg = mk("Frame", {Size = UDim2.new(1, 0, 0, 16), BackgroundColor3 = TH.surface, BorderSizePixel = 0, LayoutOrder = nextOrder()}, scroll)
            squircle(bg, 8)
            local fill = mk("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = ACTIVE, BorderSizePixel = 0}, bg)
            squircle(fill, 8)
            return function(frac)
                fill.Size = UDim2.new(math.clamp(frac or 0, 0, 1), 0, 1, 0)
            end
        end

        return W
    end

    -- =================================================================
    -- ADVANCED AUTOBUILD
    -- =================================================================
    local AB = {
        mode = "Nearest",
        passes = 3,
        running = false,
        paused = false,
        stopFlag = false,
        last = nil,
        setStatus = function() end,
        setDetail = function() end,
        setProgress = function() end,
    }
    K.AdvBuild = AB
    local MODES = {"Nearest", "Bottom-up", "Top-down", "Spawn-out"}

    local function spawnPosition()
        local s = workspace:FindFirstChild("SpawnLocation") or workspace:FindFirstChild("Spawn")
        if s then
            if s:IsA("BasePart") then return s.Position end
            if s:IsA("Model") then return s:GetPivot().Position end
        end
        local hrp = getHrp()
        return hrp and hrp.Position or Vector3.new(0, 100, 0)
    end

    -- E.status only exists once the old Auto-Build window has been opened, and
    -- that window replaces it, so we re-hook it before every run.
    local hooked
    hooked = function(text)
        AB.setDetail(tostring(text or ""))
        if AB.chain then pcall(AB.chain, text) end
    end
    function AB.hook()
        if E.status ~= hooked then
            AB.chain = E.status
            E.status = hooked
        end
    end

    function AB.orderBlocks(blocks)
        local list = table.clone(blocks)
        local hrp = getHrp()
        local origin = (AB.mode == "Spawn-out") and spawnPosition() or (hrp and hrp.Position or Vector3.zero)
        local dist = {}
        for _, b in ipairs(list) do dist[b] = (b.centerPos - origin).Magnitude end
        local function yKey(b) return math.floor(b.centerPos.Y + 0.5) end
        if AB.mode == "Bottom-up" then
            table.sort(list, function(a, b)
                local ay, by = yKey(a), yKey(b)
                if ay ~= by then return ay < by end
                return dist[a] < dist[b]
            end)
        elseif AB.mode == "Top-down" then
            table.sort(list, function(a, b)
                local ay, by = yKey(a), yKey(b)
                if ay ~= by then return ay > by end
                return dist[a] < dist[b]
            end)
        else
            table.sort(list, function(a, b) return dist[a] < dist[b] end)
        end
        return list
    end

    local function posKey(p)
        return math.floor(p.X * 2 + 0.5) .. "," .. math.floor(p.Y * 2 + 0.5) .. "," .. math.floor(p.Z * 2 + 0.5)
    end

    function AB.findMissing(blocks)
        local have = {}
        for _, brick in ipairs(E.collect("You")) do have[posKey(brick.Position)] = true end
        local missing = {}
        for _, b in ipairs(blocks) do
            if not have[posKey(b.centerPos)] then missing[#missing + 1] = b end
        end
        return missing
    end

    local CHUNK = 30

    -- runs a list of blocks through the hub's builder in small chunks so we can
    -- pause / stop between chunks and show real progress
    local function runChunks(list, headline, doneBefore, grand)
        local idx = 1
        while idx <= #list do
            while AB.paused and not AB.stopFlag do task.wait(0.2) end
            if AB.stopFlag then return false end
            local part = {}
            for i = idx, math.min(#list, idx + CHUNK - 1) do part[#part + 1] = list[i] end
            AB.setStatus(string.format("%s %d/%d", headline, doneBefore + idx - 1, grand))
            local ok, why = E.run(part, {label = headline})
            if not ok and why then
                AB.setStatus("Stopped: " .. tostring(why))
                if why == "tools" then AB.setDetail("Grab your Build + Paint (+ Shape) tools, then press Start again.") end
                return false, why
            end
            idx = idx + #part
            AB.setProgress((doneBefore + idx - 1) / math.max(1, grand))
        end
        return true
    end

    function AB.run(blocks)
        if AB.running then
            AB.setStatus("Already building")
            return false
        end
        if E.busy then
            AB.setStatus("The old Auto-Build is still running - stop it first")
            return false
        end
        if not blocks or #blocks == 0 then
            AB.setStatus("Nothing to build - load a build first")
            return false
        end
        AB.running, AB.stopFlag, AB.paused = true, false, false
        AB.last = blocks
        AB.hook()
        local ordered = AB.orderBlocks(blocks)
        local total = #ordered
        AB.setProgress(0)
        task.spawn(function()
            local ok, err = pcall(function()
                local fine = runChunks(ordered, "Building", 0, total)
                if not fine then return end
                for pass = 1, AB.passes do
                    if AB.stopFlag then return end
                    local missing = AB.findMissing(ordered)
                    if #missing == 0 then break end
                    AB.setDetail(string.format("Verify pass %d/%d: %d block(s) missing", pass, AB.passes, #missing))
                    local ok2 = runChunks(missing, "Repair " .. pass, 0, #missing)
                    if not ok2 then return end
                end
            end)
            AB.running = false
            AB.paused = false
            if not ok then
                AB.setStatus("Error: " .. tostring(err))
                addLogEntry("[AdvBuild] error: " .. tostring(err))
            elseif AB.stopFlag then
                AB.setStatus("Stopped")
            else
                local left = #AB.findMissing(ordered)
                AB.setProgress(1)
                AB.setStatus(left == 0 and string.format("Done and verified: %d/%d blocks", total, total)
                    or string.format("Finished: %d/%d verified, %d need attention (try Repair)", total - left, total, left))
                addLogEntry(string.format("[AdvBuild] finished %d/%d", total - left, total))
            end
        end)
        return true
    end

    function AB.stop()
        AB.stopFlag = true
        AB.paused = false
        pcall(E.stop)
    end

    function AB.repair()
        if not AB.last then
            AB.setStatus("No previous build to repair")
            return false
        end
        return AB.run(AB.last)
    end

    -- place the loaded build with its bottom resting at the player's feet
    function AB.originHere()
        local hrp = getHrp()
        if not (hrp and E.raw) then return false end
        local pos = Vector3.new(hrp.Position.X, hrp.Position.Y - 3 + (E.center.Y - E.bottom), hrp.Position.Z)
        local rot = E.cf and (E.cf - E.cf.Position) or CFrame.new()
        E.cf = CFrame.new(E.snapGrid(pos)) * rot
        return true
    end

    function AB.rotate()
        if not E.raw then return false end
        E.cf = (E.cf or CFrame.new(E.center)) * CFrame.Angles(0, math.rad(90), 0)
        return true
    end

    -- turns the currently loaded build back into plain JSON so it can be saved
    function AB.exportLoaded()
        if not E.raw then return nil end
        local function a3(v)
            return {math.round(v.X * 1000) / 1000, math.round(v.Y * 1000) / 1000, math.round(v.Z * 1000) / 1000}
        end
        local out = {}
        for _, r in ipairs(E.raw) do
            local s, c = r.size, r.color
            local blk = {
                c = {math.round(c.R * 255), math.round(c.G * 255), math.round(c.B * 255)},
                o = r.material.Name,
                a = r.anchored ~= false,
                cc = r.canCollide ~= false,
            }
            if s == Vector3.new(4, 4, 4) then
                blk.p = a3(r.pos)
            else
                blk.p = a3(r.pos - s / 2 + Vector3.new(0.5, 0.5, 0.5))
                blk.s = a3(s)
            end
            if r.sprays and #r.sprays > 0 then
                local sp = {}
                for _, x in ipairs(r.sprays) do sp[#sp + 1] = {x.face.Name, "", x.text} end
                blk.sp = sp
            end
            out[#out + 1] = blk
        end
        return HttpService:JSONEncode(out)
    end

    function AB.loadAny(text)
        text = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if text == "" then return nil, "type or paste something first" end
        local head = text:sub(1, 1)
        if text:sub(1, 4):lower() == "http" then return E.loadUrl(text) end
        if text:sub(1, 6):lower() == "paste:" then return E.loadPaste(text:sub(7)) end
        if head == "{" or head == "[" or head == "|" or text:sub(1, 6) == "GLAVA3" then return E.load(text) end
        local saved = K.Store and K.Store.get(text)
        if saved then return E.load(saved) end
        return E.loadFile(text)
    end

    local advGui
    function K.gui.advbuild()
        if advGui then advGui.Enabled = not advGui.Enabled; return end
        local prev = TH
        TH = THEME_LIGHT
        local W = makeWindow("KOKUWARE_ADVBUILD", "Advanced AutoBuild", 520, 700)
        advGui = W.gui
        W.label("Loads a build, orders it, builds it, then re-checks every block and repairs misses.", 36, 13)
        local statusLbl = W.label("Load a build to begin", 24, 15)
        statusLbl.Font = Enum.Font.GothamBold
        local detailLbl = W.label("", 36, 12)
        local setBar = W.progress()
        AB.setStatus = function(t) if statusLbl.Parent then statusLbl.Text = t end end
        AB.setDetail = function(t) if detailLbl.Parent then detailLbl.Text = t end end
        AB.setProgress = setBar

        local box = W.box("Paste build JSON, a link, paste:ID, or a saved file name", 96, true)

        local function afterLoad(n, err)
            if not n then
                AB.setStatus("Load failed")
                AB.setDetail(tostring(err or ""))
                return
            end
            AB.originHere()
            AB.setStatus(string.format("Loaded %d blocks", n))
            AB.setDetail("Origin set at your feet. Move, tap 'Set origin here' again, or rotate, then press Start.")
        end

        W.buttons({
            {text = "Load", primary = true, cb = function() afterLoad(AB.loadAny(box.Text)) end},
            {text = "Use map export", cb = function()
                local json = K.MapExport and K.MapExport.lastJson
                if not json then
                    AB.setStatus("No map export yet")
                    AB.setDetail("Open the Map Exporter and press Convert map first.")
                    return
                end
                afterLoad(E.load(json))
            end},
        })

        -- ---------------- saving ----------------
        local nameBox = W.box("Name to save as (letters, numbers, - or _)", 44, false)
        local filesLbl = W.label("", 0, 12)
        local function saveName()
            local n = tostring(nameBox.Text or ""):gsub("[^%w%-_]+", "_"):sub(1, 40)
            if n == "" then n = "build_" .. os.date("%H%M%S") end
            return n
        end
        local function saveJson(json, count, what)
            if not json then return end
            if not writefile then
                AB.setStatus("This executor can't write files - use Copy loaded JSON instead")
                return
            end
            local n = saveName()
            if E.saveFile(n, json) then
                AB.setStatus(string.format("Saved %d blocks (%s) as %s", count, what, n))
                AB.setDetail("Folder: " .. BUILD_DIR .. ". To load it later type  " .. n .. "  in the box above and press Load.")
            else
                AB.setStatus("Saving failed")
            end
        end
        W.buttons({
            {text = "Save loaded build", cb = function()
                local json = AB.exportLoaded()
                if not json then AB.setStatus("Load a build first"); return end
                saveJson(json, #E.raw, "loaded build")
            end},
            {text = "Save my bricks", cb = function()
                local bricks = E.collect("You")
                if #bricks == 0 then AB.setStatus("You have no bricks placed to save"); return end
                saveJson(E.exportJSON(bricks), #bricks, "your bricks")
            end},
        })
        W.buttons({
            {text = "Copy loaded JSON", cb = function()
                local json = AB.exportLoaded()
                if not json then AB.setStatus("Load a build first"); return end
                if setclipboard and pcall(setclipboard, json) then
                    AB.setStatus("Copied " .. #E.raw .. " blocks to the clipboard")
                else
                    AB.setStatus("No clipboard on this executor - use Save loaded build")
                end
            end},
            {text = "Saved files", cb = function()
                if filesLbl.Size.Y.Offset > 0 then
                    filesLbl.Size = UDim2.new(1, 0, 0, 0)
                    filesLbl.Text = ""
                    return
                end
                local names = {}
                pcall(function()
                    for _, f in ipairs(listfiles(BUILD_DIR)) do
                        local n = tostring(f):match("([^/\\]+)%.json$")
                        if n then names[#names + 1] = n end
                    end
                end)
                table.sort(names)
                if #names == 0 then
                    filesLbl.Text = "No saved builds yet in " .. BUILD_DIR
                    filesLbl.Size = UDim2.new(1, 0, 0, 20)
                else
                    filesLbl.Text = "Saved builds (type a name in the load box, then Load):\n" .. table.concat(names, "\n")
                    filesLbl.Size = UDim2.new(1, 0, 0, 20 + 16 * #names)
                end
            end},
        })

        W.buttons({
            {text = "Set origin here", cb = function()
                if AB.originHere() then AB.setStatus("Origin moved to your position") else AB.setStatus("Load a build first") end
            end},
            {text = "Rotate 90", cb = function()
                if AB.rotate() then AB.setStatus("Rotated 90 degrees") else AB.setStatus("Load a build first") end
            end},
        })

        local modeBtn = W.buttons({
            {text = "Order: " .. AB.mode, cb = function(b)
                local i = table.find(MODES, AB.mode) or 1
                AB.mode = MODES[i % #MODES + 1]
                b.Text = "Order: " .. AB.mode
            end},
        })[1]

        W.stepper(function() return "Repair passes: " .. AB.passes end,
            function() AB.passes = math.max(0, AB.passes - 1) end,
            function() AB.passes = math.min(6, AB.passes + 1) end)

        W.buttons({
            {text = "START", primary = true, cb = function()
                if not E.raw then AB.setStatus("Load a build first"); return end
                AB.run(E.layout())
            end},
            {text = "Pause / Resume", cb = function(b)
                if not AB.running then return end
                AB.paused = not AB.paused
                b.Text = AB.paused and "Resume" or "Pause / Resume"
                AB.setStatus(AB.paused and "Paused" or "Resumed")
            end},
            {text = "STOP", cb = function() AB.stop() end},
        })

        W.buttons({
            {text = "Repair last build", cb = function() AB.repair() end},
            {text = "Count missing", cb = function()
                if not E.raw then AB.setStatus("Load a build first"); return end
                local layout = E.layout()
                AB.setStatus(string.format("%d of %d blocks missing", #AB.findMissing(layout), #layout))
            end},
        })

        local helpLbl = W.label("", 0, 13)
        W.buttons({
            {text = "How it works", cb = function()
                if helpLbl.Size.Y.Offset > 0 then
                    helpLbl.Size = UDim2.new(1, 0, 0, 0)
                    helpLbl.Text = ""
                    return
                end
                helpLbl.Size = UDim2.new(1, 0, 0, 190)
                helpLbl.Text = "1) Load a build (JSON, link, paste:ID, file in Kokuware_builds, or Use map export).\n"
                    .. "2) Stand where the build should go and tap Set origin here; Rotate 90 turns it.\n"
                    .. "3) Pick an order, then START. Blocks go down in chunks so Pause and Stop react quickly.\n"
                    .. "4) When done it counts which blocks are really in your bricks and rebuilds the missing ones, up to the number of repair passes.\n"
                    .. "Needs your Build and Paint tools (plus Shape for non-4x4 blocks)."
            end},
        })
        TH = prev
    end

    -- =================================================================
    -- MAP EXPORTER
    -- =================================================================
    local MX = {lastJson = nil, lastCount = 0}
    K.MapExport = MX

    local PRESETS = {
        Compact = {step = 4, blocks = 4500, voxel = 320},
        Balanced = {step = 2, blocks = 8000, voxel = 640},
        Detailed = {step = 1, blocks = 12000, voxel = 1100},
    }
    local PRESET_ORDER = {"Compact", "Balanced", "Detailed"}
    local MIN_SIZE, MAX_SIZE, HARD_LIMIT = 1, 64, 12000
    local st = {
        root = nil, preset = "Balanced", scale = 1, limit = 8000,
        decor = true, transparent = false, busy = false, pickLevel = 1, picking = false,
    }
    MX.state = st

    local MATERIAL_TOKENS = {
        SmoothPlastic = "smooth", Plastic = "plastic", CeramicTiles = "tiles", Brick = "bricks",
        WoodPlanks = "planks", Ice = "ice", Glacier = "ice", Grass = "grass", LeafyGrass = "grass",
        Ground = "grass", Mud = "grass", Sand = "sand", Sandstone = "stone", Snow = "snow",
        Salt = "snow", Glass = "glass", ForceField = "glass", Wood = "wood", Slate = "stone",
        Rock = "stone", Basalt = "stone", Limestone = "stone", Cobblestone = "pebble",
        Pebble = "pebble", Marble = "marble", Granite = "granite", DiamondPlate = "steel",
        Metal = "metal", CorrodedMetal = "metal", Foil = "metal", Asphalt = "asphalt",
        Concrete = "concrete", Pavement = "pavement", Neon = "neon", CrackedLava = "neon",
        RoofShingles = "tiles", ClayRoofTiles = "tiles", Rubber = "plastic", Fabric = "smooth",
        Carpet = "smooth", Leather = "smooth", Cardboard = "smooth", Plaster = "smooth",
    }

    local function roundTo(v, step)
        step = math.max(0.001, tonumber(step) or 1)
        return math.round((tonumber(v) or 0) / step) * step
    end
    local function floorTo(v, step)
        step = math.max(0.001, tonumber(step) or 1)
        return math.floor((tonumber(v) or 0) / step + 1e-6) * step
    end
    local function ceilTo(v, step)
        step = math.max(0.001, tonumber(step) or 1)
        return math.ceil((tonumber(v) or 0) / step - 1e-6) * step
    end
    local function arr3(v)
        return {math.round(v.X * 1000) / 1000, math.round(v.Y * 1000) / 1000, math.round(v.Z * 1000) / 1000}
    end

    local function worldBounds(part)
        local cf, size = part.CFrame, part.Size
        local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
        local ext = Vector3.new(
            math.abs(r.X) * size.X + math.abs(u.X) * size.Y + math.abs(l.X) * size.Z,
            math.abs(r.Y) * size.X + math.abs(u.Y) * size.Y + math.abs(l.Y) * size.Z,
            math.abs(r.Z) * size.X + math.abs(u.Z) * size.Y + math.abs(l.Z) * size.Z
        )
        return cf.Position - ext / 2, cf.Position + ext / 2
    end

    local function cardinal(v)
        local ax, ay, az = math.abs(v.X), math.abs(v.Y), math.abs(v.Z)
        return math.max(ax, ay, az) >= 0.999 and (ax + ay + az) <= 1.002
    end
    local function axisAligned(part)
        local cf = part.CFrame
        return cardinal(cf.RightVector) and cardinal(cf.UpVector) and cardinal(cf.LookVector)
    end

    local function isCharacterPart(part)
        local a = part:FindFirstAncestorOfClass("Model")
        while a and a ~= workspace do
            if Players:GetPlayerFromCharacter(a) or a:FindFirstChildOfClass("Humanoid") then return true end
            a = a:FindFirstAncestorOfClass("Model")
        end
        return false
    end

    local function eligible(part)
        if not part:IsA("BasePart") or not part:IsDescendantOf(workspace) then return false end
        if part:FindFirstAncestorOfClass("Tool") or isCharacterPart(part) then return false end
        local s = part.Size
        if s.X <= 0 or s.Y <= 0 or s.Z <= 0 then return false end
        if not st.transparent and part.Transparency >= 0.97 then return false end
        if not st.decor and not part.CanCollide then return false end
        return true
    end

    local function countParts(root, limit)
        limit = limit or 30000
        local n = (root:IsA("BasePart") and eligible(root)) and 1 or 0
        for _, d in ipairs(root:GetDescendants()) do
            if eligible(d) then
                n = n + 1
                if n >= limit then break end
            end
        end
        return n
    end

    local function autoDetect()
        local best, bestScore, bestCount = nil, -math.huge, 0
        local hints = {map = 8, structure = 7, island = 6, level = 5, stage = 5, terrain = 4, disaster = 4}
        for _, c in ipairs(workspace:GetChildren()) do
            if (c:IsA("Model") or c:IsA("Folder")) and c ~= LocalPlayer.Character then
                local n = countParts(c, 30000)
                if n > 0 then
                    local score = n
                    local lname = c.Name:lower()
                    for hint, weight in pairs(hints) do
                        if lname:find(hint, 1, true) then score = score * weight; break end
                    end
                    if score > bestScore then best, bestScore, bestCount = c, score, n end
                end
            end
        end
        return best or workspace, bestCount > 0 and bestCount or countParts(workspace, 30000)
    end

    -- "Workspace.Map.Island" or just "Island"
    local function resolvePath(text)
        text = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if text == "" then return nil end
        local cur = workspace
        local parts = text:split(".")
        local first = parts[1] and parts[1]:lower()
        if first == "workspace" or first == "game" then table.remove(parts, 1) end
        for _, name in ipairs(parts) do
            local nxt = cur:FindFirstChild(name)
            if not nxt then nxt = cur:FindFirstChild(name, true) end
            if not nxt then return nil end
            cur = nxt
        end
        return cur
    end

    local function collectParts(root)
        local parts, scanned = {}, 0
        if root:IsA("BasePart") and eligible(root) then parts[1] = root end
        for _, d in ipairs(root:GetDescendants()) do
            scanned = scanned + 1
            if eligible(d) then
                parts[#parts + 1] = d
                if #parts >= 30000 then break end
            end
            if scanned % 500 == 0 then task.wait() end
        end
        table.sort(parts, function(a, b)
            local av = (a.CanCollide and 1e12 or 0) + a.Size.X * a.Size.Y * a.Size.Z
            local bv = (b.CanCollide and 1e12 or 0) + b.Size.X * b.Size.Y * b.Size.Z
            return av > bv
        end)
        return parts
    end

    local function pointInside(part, worldPoint, pad)
        local p = part.CFrame:PointToObjectSpace(worldPoint)
        local half = part.Size / 2 + Vector3.new(pad, pad, pad)
        if part:IsA("Part") and part.Shape == Enum.PartType.Ball then
            local nx, ny, nz = p.X / math.max(half.X, 0.001), p.Y / math.max(half.Y, 0.001), p.Z / math.max(half.Z, 0.001)
            return nx * nx + ny * ny + nz * nz <= 1
        end
        if part:IsA("Part") and part.Shape == Enum.PartType.Cylinder then
            local ny, nz = p.Y / math.max(half.Y, 0.001), p.Z / math.max(half.Z, 0.001)
            return math.abs(p.X) <= half.X and ny * ny + nz * nz <= 1
        end
        return math.abs(p.X) <= half.X and math.abs(p.Y) <= half.Y and math.abs(p.Z) <= half.Z
    end

    -- Converts every part under `root` into 1..64 stud axis-aligned blocks
    local function buildMap(root, setProgress)
        local prof = PRESETS[st.preset] or PRESETS.Balanced
        local scale = math.clamp(tonumber(st.scale) or 1, 0.1, 4)
        local limit = math.clamp(math.floor(tonumber(st.limit) or prof.blocks), 100, HARD_LIMIT)
        local parts = collectParts(root)
        if #parts == 0 then return nil, "No exportable parts were found under that source." end

        local bmin = Vector3.new(math.huge, math.huge, math.huge)
        local bmax = Vector3.new(-math.huge, -math.huge, -math.huge)
        for _, part in ipairs(parts) do
            local lo, hi = worldBounds(part)
            bmin = Vector3.new(math.min(bmin.X, lo.X), math.min(bmin.Y, lo.Y), math.min(bmin.Z, lo.Z))
            bmax = Vector3.new(math.max(bmax.X, hi.X), math.max(bmax.Y, hi.Y), math.max(bmax.Z, hi.Z))
        end

        local blocks, seen = {}, {}
        local stats = {sourceParts = #parts, exact = 0, voxel = 0, boxed = 0, truncated = false}

        local function addBlock(lower, size, part)
            if #blocks >= limit then stats.truncated = true; return false end
            size = Vector3.new(
                math.clamp(roundTo(size.X, 1), MIN_SIZE, MAX_SIZE),
                math.clamp(roundTo(size.Y, 1), MIN_SIZE, MAX_SIZE),
                math.clamp(roundTo(size.Z, 1), MIN_SIZE, MAX_SIZE))
            lower = Vector3.new(roundTo(lower.X, 1), roundTo(lower.Y, 1), roundTo(lower.Z, 1))
            local key = string.format("%.1f|%.1f|%.1f|%.1f|%.1f|%.1f", lower.X, lower.Y, lower.Z, size.X, size.Y, size.Z)
            if seen[key] then return true end
            seen[key] = true
            local center = lower + size / 2
            local col = part.Color
            local is4 = size == Vector3.new(4, 4, 4)
            local blk = {
                p = arr3(is4 and center or (lower + Vector3.new(0.5, 0.5, 0.5))),
                c = {
                    math.clamp(math.floor(col.R * 255 + 0.5), 0, 255),
                    math.clamp(math.floor(col.G * 255 + 0.5), 0, 255),
                    math.clamp(math.floor(col.B * 255 + 0.5), 0, 255),
                },
                m = MATERIAL_TOKENS[part.Material.Name] or "smooth",
                o = part.Material.Name,
                a = true,
                cc = part.CanCollide == true,
            }
            if not is4 then blk.s = arr3(size) end
            blocks[#blocks + 1] = blk
            return true
        end

        local function tileBox(rmin, rmax, part)
            local step = prof.step
            local qmin = Vector3.new(floorTo(rmin.X, step), floorTo(rmin.Y, step), floorTo(rmin.Z, step))
            local qmax = Vector3.new(ceilTo(rmax.X, step), ceilTo(rmax.Y, step), ceilTo(rmax.Z, step))
            qmax = Vector3.new(math.max(qmax.X, qmin.X + step), math.max(qmax.Y, qmin.Y + step), math.max(qmax.Z, qmin.Z + step))
            local x = qmin.X
            while x < qmax.X do
                local sx = math.min(MAX_SIZE, qmax.X - x)
                local y = qmin.Y
                while y < qmax.Y do
                    local sy = math.min(MAX_SIZE, qmax.Y - y)
                    local z = qmin.Z
                    while z < qmax.Z do
                        local sz = math.min(MAX_SIZE, qmax.Z - z)
                        if not addBlock(Vector3.new(x, y, z), Vector3.new(sx, sy, sz), part) then return false end
                        z = z + sz
                    end
                    y = y + sy
                end
                x = x + sx
            end
            return true
        end

        for index, part in ipairs(parts) do
            if #blocks >= limit then stats.truncated = true; break end
            local lo, hi = worldBounds(part)
            local rmin, rmax = (lo - bmin) * scale, (hi - bmin) * scale
            local isPart = part:IsA("Part")
            local oddShape = isPart and part.Shape ~= Enum.PartType.Block
            local useVoxel = (not axisAligned(part)) or oddShape

            if useVoxel then
                local v = prof.step
                local qmin = Vector3.new(floorTo(rmin.X, v), floorTo(rmin.Y, v), floorTo(rmin.Z, v))
                local qmax = Vector3.new(ceilTo(rmax.X, v), ceilTo(rmax.Y, v), ceilTo(rmax.Z, v))
                local estimate = math.max(1, math.ceil((qmax.X - qmin.X) / v))
                    * math.max(1, math.ceil((qmax.Y - qmin.Y) / v))
                    * math.max(1, math.ceil((qmax.Z - qmin.Z) / v))
                if estimate <= prof.voxel and estimate <= (limit - #blocks) then
                    stats.voxel = stats.voxel + 1
                    local pad = (v / scale) * 0.58
                    local full = false
                    local x = qmin.X
                    while x < qmax.X and not full do
                        local y = qmin.Y
                        while y < qmax.Y and not full do
                            local z = qmin.Z
                            while z < qmax.Z and not full do
                                local center = Vector3.new(x, y, z) + Vector3.new(v, v, v) / 2
                                local world = bmin + center / scale
                                if pointInside(part, world, pad) then
                                    if not addBlock(Vector3.new(x, y, z), Vector3.new(v, v, v), part) then full = true end
                                end
                                z = z + v
                            end
                            y = y + v
                        end
                        x = x + v
                    end
                else
                    stats.boxed = stats.boxed + 1
                    tileBox(rmin, rmax, part)
                end
            else
                stats.exact = stats.exact + 1
                tileBox(rmin, rmax, part)
            end

            if index % 30 == 0 then
                task.wait()
                if setProgress then setProgress(index / #parts, #blocks) end
            end
        end

        if #blocks == 0 then return nil, "The conversion produced no blocks." end
        stats.size = (bmax - bmin) * scale
        return blocks, stats
    end
    MX.buildMap = buildMap

    local function resolveTop(inst, level)
        if not inst then return nil end
        if level == 3 then return inst end
        if level == 2 then
            return (inst.Parent and inst.Parent ~= workspace) and inst.Parent or inst
        end
        local cur = inst
        while cur.Parent and cur.Parent ~= workspace do cur = cur.Parent end
        return cur
    end

    local mxGui
    function K.gui.mapexport()
        if mxGui then mxGui.Enabled = not mxGui.Enabled; return end
        local prev = TH
        TH = THEME_LIGHT
        local W = makeWindow("KOKUWARE_MAPEXPORT", "Map Exporter", 520, 760)
        mxGui = W.gui
        W.label("Turns a map into building blocks you can rebuild with Advanced AutoBuild.", 36, 13)
        local rootLbl = W.label("Source: not chosen (Convert will auto-detect)", 40, 14)

        local function setRoot(inst, why)
            st.root = inst
            if inst then
                rootLbl.Text = "Source: " .. inst:GetFullName() .. (why and ("  (" .. why .. ")") or "")
            end
        end

        local pickBtn
        W.buttons({
            {text = "Auto-detect map", cb = function()
                if st.busy then return end
                st.busy = true
                rootLbl.Text = "Scanning workspace..."
                task.spawn(function()
                    local ok, found, count = pcall(autoDetect)
                    if ok and found then setRoot(found, count .. " parts") else rootLbl.Text = "Scan failed, workspace will be used" end
                    st.busy = false
                end)
            end},
            {text = "Tap map to select: OFF", cb = function(b)
                st.picking = not st.picking
                b.Text = "Tap map to select: " .. (st.picking and "ON" or "OFF")
                if st.picking then rootLbl.Text = "Tap any part of the map in the 3D world..." end
            end},
        })
        pickBtn = nil

        W.buttons({
            {text = "Pick level: Top model", cb = function(b)
                st.pickLevel = st.pickLevel % 3 + 1
                b.Text = "Pick level: " .. ({"Top model", "Parent model", "Exact part"})[st.pickLevel]
            end},
        })

        local pathBox = W.box("Or type a path, e.g. Workspace.Map", 44, false)
        W.buttons({
            {text = "Use typed path", cb = function()
                local inst = resolvePath(pathBox.Text)
                if inst then setRoot(inst, "typed") else rootLbl.Text = "Couldn't find that path" end
            end},
        })

        -- world tapping (touch + mouse)
        local function pickAt(screenPos)
            if not st.picking then return end
            local cam = workspace.CurrentCamera
            if not cam then return end
            local ray = cam:ViewportPointToRay(screenPos.X, screenPos.Y)
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = LocalPlayer.Character and {LocalPlayer.Character} or {}
            local hit = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
            if hit and hit.Instance then
                setRoot(resolveTop(hit.Instance, st.pickLevel), "tapped")
            end
        end
        W.gui.Destroying:Connect(function() st.picking = false end)
        UIS.TouchTapInWorld:Connect(function(pos, processed)
            if not processed then pickAt(pos) end
        end)
        UIS.InputBegan:Connect(function(input, processed)
            if processed then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 then pickAt(UIS:GetMouseLocation()) end
        end)

        W.buttons({
            {text = "Quality: " .. st.preset, cb = function(b)
                local i = table.find(PRESET_ORDER, st.preset) or 2
                st.preset = PRESET_ORDER[i % #PRESET_ORDER + 1]
                st.limit = PRESETS[st.preset].blocks
                b.Text = "Quality: " .. st.preset
            end},
        })
        W.stepper(function() return string.format("Scale: %.2f", st.scale) end,
            function() st.scale = math.max(0.1, roundTo(st.scale - 0.25, 0.05)) end,
            function() st.scale = math.min(4, roundTo(st.scale + 0.25, 0.05)) end)
        W.stepper(function() return "Block limit: " .. st.limit end,
            function() st.limit = math.max(100, st.limit - 500) end,
            function() st.limit = math.min(HARD_LIMIT, st.limit + 500) end)
        W.buttons({
            {text = "Decorations: ON", cb = function(b)
                st.decor = not st.decor
                b.Text = "Decorations: " .. (st.decor and "ON" or "OFF")
            end},
            {text = "Transparent: OFF", cb = function(b)
                st.transparent = not st.transparent
                b.Text = "Transparent: " .. (st.transparent and "ON" or "OFF")
            end},
        })

        local statusLbl = W.label("Ready. Choose a source (or just press Convert).", 64, 13)
        local setBar = W.progress()

        local function say(t) if statusLbl.Parent then statusLbl.Text = t end end

        W.buttons({
            {text = "Convert map", primary = true, cb = function()
                if st.busy then say("A conversion is already running"); return end
                st.busy = true
                MX.lastJson, MX.lastCount = nil, 0
                setBar(0)
                say("Scanning and converting...")
                task.spawn(function()
                    local ok, err = xpcall(function()
                        local root = st.root
                        if typeof(root) ~= "Instance" or (root ~= workspace and not root:IsDescendantOf(workspace)) then
                            root = autoDetect()
                            setRoot(root, "auto")
                        end
                        local blocks, stats = buildMap(root, function(frac, n)
                            setBar(frac)
                            say(string.format("Converting... %d blocks so far", n))
                        end)
                        if not blocks then error(tostring(stats), 0) end
                        MX.lastJson = HttpService:JSONEncode(blocks)
                        MX.lastCount = #blocks
                        setBar(1)
                        say(string.format("Done: %d blocks from %d parts (exact %d, voxel %d, boxed %d)%s. Size about %d x %d x %d studs. Now Send to AutoBuild, Copy or Save.",
                            #blocks, stats.sourceParts, stats.exact, stats.voxel, stats.boxed,
                            stats.truncated and ", LIMIT REACHED" or "",
                            math.floor(stats.size.X), math.floor(stats.size.Y), math.floor(stats.size.Z)))
                    end, debug.traceback)
                    st.busy = false
                    if not ok then say(tostring(err):match("^[^\n]+") or "Conversion failed") end
                end)
            end},
        })

        local function needExport()
            if MX.lastJson then return false end
            say("Press Convert map first")
            return true
        end

        local outBox
        W.buttons({
            {text = "Send to AutoBuild", cb = function()
                if needExport() then return end
                local n, err = E.load(MX.lastJson)
                if not n then say("AutoBuild couldn't load it: " .. tostring(err)); return end
                AB.originHere()
                say(string.format("Sent %d blocks to Advanced AutoBuild. Opening it...", n))
                if advGui == nil or not advGui.Enabled then K.gui.advbuild() end
                AB.setStatus(string.format("Loaded %d blocks from map export", n))
                AB.setDetail("Origin set at your feet. Adjust if needed, then press Start.")
            end},
            {text = "Copy JSON", cb = function()
                if needExport() then return end
                if setclipboard then
                    pcall(setclipboard, MX.lastJson)
                    say("Copied " .. MX.lastCount .. " blocks to the clipboard")
                else
                    say("This executor has no clipboard - use Save file or Show text")
                end
            end},
        })
        W.buttons({
            {text = "Save file", cb = function()
                if needExport() then return end
                if not writefile then say("This executor can't write files - use Show text"); return end
                local name = (st.root and st.root.Name or "map"):gsub("[^%w%-_]+", "_"):sub(1, 40)
                local ok = E.saveFile(name .. "_" .. os.date("%H%M%S"), MX.lastJson)
                say(ok and ("Saved to " .. BUILD_DIR .. "/" .. name .. "_*.json (Advanced AutoBuild can load it by file name)")
                    or "Saving failed")
            end},
            {text = "Show text", cb = function()
                if needExport() then return end
                if #MX.lastJson > 190000 then
                    say("Too long to show (" .. #MX.lastJson .. " chars). Use Send to AutoBuild or Save file.")
                    return
                end
                outBox.Visible = true
                outBox.Text = MX.lastJson
                say("Tap the box, select all, copy.")
            end},
        })
        outBox = W.box("Export text appears here", 120, true)
        outBox.Visible = false

        local helpLbl = W.label("", 0, 13)
        W.buttons({
            {text = "How it works", cb = function()
                if helpLbl.Size.Y.Offset > 0 then
                    helpLbl.Size = UDim2.new(1, 0, 0, 0)
                    helpLbl.Text = ""
                    return
                end
                helpLbl.Size = UDim2.new(1, 0, 0, 250)
                helpLbl.Text = "It reads every part under the source you choose, skipping characters and tools.\n"
                    .. "Boxes lined up with the world axes become exact blocks (large ones are cut into pieces up to 64 studs).\n"
                    .. "Rotated, round or wedge parts are filled with small cubes, as long as the part stays under the cube budget; otherwise it falls back to a bounding box.\n"
                    .. "Quality sets the cube size (Compact 4, Balanced 2, Detailed 1). Scale shrinks or grows the whole map. Block limit stops runaway exports.\n"
                    .. "Colors, materials and collision are copied. Coordinates are relative to the map corner, so Send to AutoBuild grounds it at your feet."
            end},
        })
        TH = prev
    end

end


do
    local E = K.Build
    local G = {active = false, gen = 0, queue = {}, cache = {}, conns = {}, pauseUntil = 0, lastAlert = "none",
        cfg = {threshold = 5, window = 2, minTime = 60, autofix = true, strip = true, warn = false}}
    K.AntiGrief = G
    G.isProtected = function() return false end

    local function playerTime(name)
        local p = Players:FindFirstChild(name)
        local ls = p and p:FindFirstChild("leaderstats")
        local tv = ls and ls:FindFirstChild("Time")
        return tv and tv.Value or 0
    end
    local function medianTime()
        local times = {}
        for _, p in ipairs(Players:GetPlayers()) do
            local ls = p:FindFirstChild("leaderstats")
            local tv = ls and ls:FindFirstChild("Time")
            if tv then table.insert(times, tv.Value) end
        end
        if #times == 0 then return 0 end
        table.sort(times)
        return times[math.ceil(#times / 2)]
    end
    local function priority(bd) return (bd.sprays and #bd.sprays > 0) and 1 or 0 end

    local function findGriefer(center, victimName)
        local minDist, griefer = 60, nil
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name ~= victimName and p ~= LocalPlayer and not G.isProtected(p) then
                local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = (hrp.Position - center).Magnitude
                    if d < minDist then minDist, griefer = d, p end
                end
            end
        end
        return griefer
    end

    local function restoreBlocks(blocks, owner)
        table.sort(blocks, function(a, b) return priority(a) > priority(b) end)
        local t0 = os.clock()
        while E.busy and os.clock() - t0 < 60 and G.active do task.wait(0.5) end
        if not G.active then return end
        addLogEntry("[AntiGrief] rebuilding " .. #blocks .. " blocks for " .. owner)
        E.run(blocks, {label = "Auto-fix"})
    end

    local function ownerOf(bf, b)
        local p = b
        while p.Parent and p.Parent ~= bf do p = p.Parent end
        if p == b or not p.Parent then return nil end
        return p.Name
    end

    local function onRemoved(b)
        if not (b:IsA("BasePart") and b.Name == "Brick") then return end
        local owner = G.cache[b]; G.cache[b] = nil
        if not owner or os.clock() < G.pauseUntil then return end
        local ownerPlayer = Players:FindFirstChild(owner)
        if not ownerPlayer then return end
        local pos = b.Position
        local ohrp = ownerPlayer.Character and ownerPlayer.Character:FindFirstChild("HumanoidRootPart")
        if ohrp then
            local od = (ohrp.Position - pos).Magnitude
            if od < 20 then
                local closer = false
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= ownerPlayer and p ~= LocalPlayer then
                        local h = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                        if h and (h.Position - pos).Magnitude < od then closer = true; break end
                    end
                end
                if not closer then return end
            end
        end
        local ok, bd = pcall(E.brickToBlock, b)
        if not ok or not bd then return end
        if #G.queue > 3000 then table.remove(G.queue, 1) end
        table.insert(G.queue, {time = os.clock(), owner = owner, block = bd, pos = pos})
    end

    local function evaluate()
        local now, c = os.clock(), G.cfg
        local fresh = {}
        for _, ev in ipairs(G.queue) do if now - ev.time <= 60 then fresh[#fresh + 1] = ev end end
        G.queue = fresh
        if now < G.pauseUntil then return end

        local burst, owners, seen = 0, 0, {}
        for _, ev in ipairs(G.queue) do
            if now - ev.time <= 1 then
                burst += 1
                if not seen[ev.owner] then seen[ev.owner] = true; owners += 1 end
            end
        end
        if burst >= 150 and owners >= 3 then
            G.queue = {}; G.pauseUntil = now + 30
            addLogEntry("[AntiGrief] looks like a server wipe - ignoring for 30s")
            return
        end

        local byOwner = {}
        for _, ev in ipairs(G.queue) do
            if now - ev.time <= c.window then
                byOwner[ev.owner] = byOwner[ev.owner] or {}
                table.insert(byOwner[ev.owner], ev)
            end
        end
        for owner, events in pairs(byOwner) do
            if #events >= c.threshold then
                local victimTime, median = playerTime(owner), medianTime()
                local ratio = median > 0 and (victimTime / median) or 0
                local ignore = victimTime > 0 and victimTime < c.minTime and ratio < 0.3

                local restore, rest = {}, {}
                local sx, sy, sz, n = 0, 0, 0, 0
                for _, ev in ipairs(G.queue) do
                    if ev.owner == owner then
                        restore[#restore + 1] = ev.block
                        sx += ev.pos.X; sy += ev.pos.Y; sz += ev.pos.Z; n += 1
                    else
                        rest[#rest + 1] = ev
                    end
                end
                G.queue = rest

                if not ignore and n > 0 then
                    local griefer = findGriefer(Vector3.new(sx / n, sy / n, sz / n), owner)
                    local gname = griefer and griefer.Name or ""
                    if c.strip and gname ~= "" then sendRaw(";clearinv " .. chatName(gname)) end
                    if c.warn then
                        sendRaw((gname ~= "" and gname or "someone") .. " HAS BEEN DETECTED GRIEFING " .. owner .. "'s build")
                    end
                    G.lastAlert = owner .. " lost " .. #restore .. " blocks" .. (gname ~= "" and (" (suspect: " .. gname .. ")") or "")
                    addLogEntry("[AntiGrief] " .. owner .. " lost " .. #restore .. " blocks" .. (gname ~= "" and (" - suspect: " .. gname) or ""))
                    if c.autofix then task.spawn(restoreBlocks, restore, owner) end
                end
            end
        end
    end

    function G.stop()
        G.active = false
        G.gen += 1
        for _, cn in ipairs(G.conns) do pcall(function() cn:Disconnect() end) end
        G.conns, G.queue, G.cache = {}, {}, {}
    end

    function G.start()
        G.stop()
        local bf = workspace:FindFirstChild("Bricks")
        if not bf then return false end
        G.active = true
        local gen = G.gen
        for _, b in ipairs(bf:GetDescendants()) do
            if b:IsA("BasePart") and b.Name == "Brick" then
                local o = ownerOf(bf, b)
                if o then G.cache[b] = o end
            end
        end
        table.insert(G.conns, bf.DescendantAdded:Connect(function(b)
            if b:IsA("BasePart") and b.Name == "Brick" then
                local o = ownerOf(bf, b)
                if o then G.cache[b] = o end
            end
        end))
        table.insert(G.conns, bf.DescendantRemoving:Connect(onRemoved))
        table.insert(G.conns, Players.PlayerRemoving:Connect(function(p)
            local keep = {}
            for _, ev in ipairs(G.queue) do if ev.owner ~= p.Name then keep[#keep + 1] = ev end end
            G.queue = keep
        end))
        task.spawn(function()
            while G.active and G.gen == gen do
                task.wait(0.3)
                pcall(evaluate)
            end
        end)
        return true
    end

    local function onOff(v)
        v = tostring(v or ""):lower()
        if v == "on" or v == "true" or v == "yes" then return true end
        if v == "off" or v == "false" or v == "no" then return false end
        return nil
    end

    function G.summary()
        local c = G.cfg
        return ("Anti-grief %s | threshold %d | window %ss | mintime %ds | autofix %s | strip %s | warn %s"):format(
            G.active and "ON" or "off", c.threshold, tostring(c.window), c.minTime,
            c.autofix and "on" or "off", c.strip and "on" or "off", c.warn and "on" or "off")
    end

    function G.set(opt, val)
        opt = tostring(opt or ""):lower()
        local c, n = G.cfg, tonumber(val)
        if opt == "threshold" and n then c.threshold = math.clamp(math.floor(n), 2, 100)
        elseif opt == "window" and n then c.window = math.clamp(n, 0.5, 15)
        elseif opt == "mintime" and n then c.minTime = math.max(0, n)
        elseif (opt == "autofix" or opt == "strip" or opt == "warn") and onOff(val) ~= nil then c[opt] = onOff(val)
        else return false, "Usage: !griefset threshold|window|mintime <n> or autofix|strip|warn on/off" end
        return true, G.summary()
    end
end

