            local mid = makeLabel(row, getText(), UDim2.new(0.6, 0, 1, 0), UDim2.new(0.2, 0, 0, 0), 15, Vector2.new(0, 0))
            local function refresh() mid.Text = getText() end
            minus.Activated:Connect(function() onMinus(); refresh() end)
            plus.Activated:Connect(function() onPlus(); refresh() end)
            return refresh
        end

        function W.box(placeholder, h, multiline)
            local t = makeBox(scroll, UDim2.new(1, 0, 0, h or 44), UDim2.new(0, 0, 0, 0), "", placeholder, Vector2.new(0, 0))
            t.LayoutOrder = nextOrder()
            t.TextSize = 14
            t.TextXAlignment = Enum.TextXAlignment.Left
