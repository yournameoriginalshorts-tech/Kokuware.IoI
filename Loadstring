    local function processCommand(sender, message)
        if not sender or not message then return end
        local isPerm = K.Access.isPermOwner(sender)
        if not isPerm and K.Access.isBlacklisted(sender) then return end
        local clean = message:lower():gsub("^%s+",""):gsub("%s+$","")

        if sender == LocalPlayer then
            local sentAt = K.selfSent[message]
            if sentAt and os.clock() - sentAt < 5 then return end
        end

        local body
        local first = clean:sub(1, 1)
        if Prefix ~= "" and clean:sub(1, #Prefix) == Prefix then
            body = clean:sub(#Prefix + 1)
        else
            for _, p in ipairs(PREFIXES) do
                if first == p then body = clean:sub(2); break end
            end
        end
        if not body then return end

        local earlyName = body:match("^%s*(%S+)")

        if first == ";" and (earlyName == "donate" or earlyName == "clearinv" or message:match("^%s*;R6%s*$")) then return end

        if not (sender == LocalPlayer and earlyName == "logs") and not isPerm and not isAllowed(sender) then
            if earlyName and (" "..commandNames:lower().." "):find(" "..earlyName.." ", 1, true) then
                addLogEntry("[Denied] "..sender.Name.." tried !"..earlyName.." (not owner/mod on this bot)")
            end
            return
        end

        _G.KokuwareLast = _G.KokuwareLast or {}
        local key = sender.UserId..":"..message
        local now = os.clock()
        local last = _G.KokuwareLast
        if last[key] and now-last[key] < 1.5 then return end
        last[key] = now
        if sender ~= LocalPlayer and not isOwner(sender) then
            addLogEntry("[Mod cmd] "..sender.Name..": "..message)
        end

        local name = earlyName
        if not name then return end
        local prefixLen = (Prefix ~= "" and clean:sub(1, #Prefix) == Prefix) and #Prefix or 1
        local stripped  = (message:gsub("^%s+", "")):sub(prefixLen + 1)
        local rawArgs   = stripped:match("^%s*%S+%s*(.-)%s*$") or ""
        local lowerArgs = rawArgs:lower()

        if name == "unload" or name == "shutdown" then
            doUnload()
            sendChat("Unloaded")

        elseif name == "logs" then
            if sender ~= LocalPlayer then toggleLogs() end

        elseif name == "logmode" then
            if lowerArgs == "cmds" or lowerArgs == "all" then
                spyMode = lowerArgs
                addLogEntry("[Logs] now logging "..spyMode)
                sendChat("Log mode: "..spyMode)
            else
                sendChat("Usage: !logmode all | cmds")
            end

        elseif name == "anticlone" then
            if lowerArgs == "off" then
                antiCloneOn = false; sendChat("Anti-clone off")
            else
                antiCloneOn = true; sendChat("Anti-clone on")
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and looksLikeClone(obj) then queueClone(obj) end
                end
            end

        elseif name == "sign" then
            local word = lowerArgs:gsub("%s+","")
            if word ~= "" then
                local letter = word:sub(getSignIndex(), getSignIndex())
                sendChat(LETTER_DECALS[letter] and tostring(LETTER_DECALS[letter]) or ".")
            end

        elseif name == "rejoin" then
            pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)

        elseif name == "reset" then
            loopActive, loopMsg, adallActive = false, "", false
            stopDance(); stopAllMovement(); restoreMap()
            if hiding then hiding = false; if hidePartObj then hidePartObj:Destroy(); hidePartObj = nil end end
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health = 0 end

        elseif name == "hide" then
            if not hiding then
                local char = LocalPlayer.Character
                if char then returnPos = char:GetPivot(); char:PivotTo(CFrame.new(hidePos+Vector3.new(0,3,0))) end
                hidePartObj = Instance.new("Part")
                hidePartObj.Size, hidePartObj.Position, hidePartObj.Anchored = Vector3.new(20,1,20), hidePos, true
                hidePartObj.Parent = workspace; hiding = true
