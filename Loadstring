    local function moveMapUp()
        if mapMovedUp then return end
        originalMapCFrames = {}
        for _, desc in ipairs(workspace:GetDescendants()) do
            if desc:IsA("BasePart") and desc.Anchored
            and not desc:IsDescendantOf(LocalPlayer.Character or workspace)
            and not desc:IsDescendantOf(movementPlatform or workspace) then
