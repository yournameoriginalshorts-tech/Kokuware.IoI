        function W.stepper(getText, onMinus, onPlus)
            local row = mk("Frame", {Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1, LayoutOrder = nextOrder()}, scroll)
            local minus = makeButton(row, "-", UDim2.new(0.2, -6, 1, 0), UDim2.new(0, 3, 0, 0), false, Vector2.new(0, 0))
            local plus = makeButton(row, "+", UDim2.new(0.2, -6, 1, 0), UDim2.new(0.8, 3, 0, 0), false, Vector2.new(0, 0))
