    local function startDance(n)
        stopDance()
        local myDance = danceGen
        local id = DANCES[n]; if not id then return end
        local char = LocalPlayer.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then addLogEntry("[Dance] no humanoid found"); return end
        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then animator = Instance.new("Animator"); animator.Parent = hum end
        local numId = tonumber(id)

        local methods = {
            {name="emote API", play=false, fn=function()
                return hum:PlayEmoteAndGetAnimTrackById(numId)
            end},
            {name="asset animation", play=true, fn=function()
                for _, o in ipairs(game:GetObjects("rbxassetid://"..id)) do
                    local a = o:IsA("Animation") and o or o:FindFirstChildWhichIsA("Animation", true)
                    if a then return animator:LoadAnimation(a) end
                    local ks = o:IsA("KeyframeSequence") and o or o:FindFirstChildWhichIsA("KeyframeSequence", true)
                    if ks then
                        local anim = Instance.new("Animation")
                        anim.AnimationId = game:GetService("KeyframeSequenceProvider"):RegisterKeyframeSequence(ks)
                        return animator:LoadAnimation(anim)
                    end
                end
            end},
            {name="direct id", play=true, fn=function()
                local anim = Instance.new("Animation")
                anim.AnimationId = "rbxassetid://"..id
                return animator:LoadAnimation(anim)
            end},
        }

        for _, m in ipairs(methods) do
            if myDance ~= danceGen then return end
            local ok, track = pcall(m.fn)
            if ok and track then
                track.Looped   = true
                track.Priority = Enum.AnimationPriority.Action4
                if m.play then pcall(function() track:Play() end) end
                if trackLoaded(track) then
                    if myDance ~= danceGen then pcall(function() track:Stop() end); return end
                    danceTrack = track
                    addLogEntry("[Dance] "..n.." playing via "..m.name)
                    return
                end
                pcall(function() track:Stop() end)
            end
        end
        addLogEntry("[Dance] "..n.." failed (R6 rig, or this emote can't be used in this game)")
    end

