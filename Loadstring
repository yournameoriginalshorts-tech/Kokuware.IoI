        str = str:gsub("[^%w%+/]", "")
        local out, n = {}, 0
        for i = 1, #str, 4 do
            local a, b, c, d = str:byte(i, i + 3)
            local v = B64I[a] * 262144 + B64I[b] * 4096 + (c and B64I[c] or 0) * 64 + (d and B64I[d] or 0)
            local chunk = string.char(math.floor(v / 65536) % 256, math.floor(v / 256) % 256, v % 256)
            n += 1
            out[n] = chunk:sub(1, math.min(4, #str - i + 1) - 1)
            if n % 30000 == 0 then task.wait() end
        end
        return table.concat(out)
    end

    -- the whole GitHub Buildsave.json as a table ({} = file doesn't exist yet, nil = couldn't reach GitHub)
    local function ghFetchStore()
        local http = getHttp()
        if not http then return nil end
        local tok = readToken()
        for _, useTok in ipairs(tok and {true, false} or {false}) do
            local okG, res = pcall(http, {Url = GH_API .. "?ref=main", Method = "GET",
                Headers = ghHeaders(useTok and tok or nil, "application/vnd.github.raw")})
            if okG and res then
                if res.StatusCode == 404 then return {} end
                if res.StatusCode == 200 then return decodeStore(res.Body) end
                if res.StatusCode ~= 401 then return nil end   -- 401 = bad token, retry without it
            else
                return nil
            end
        end
        return nil
    end

    -- value = string to store, or nil to delete. returns ok, reason
    local function ghPush(name, value)
        local tok = readToken()
        local http = getHttp()
        if not http then return false, "executor has no http request" end
        if not tok then return false, "no GitHub token set (Setup tab)" end
        local hdr = ghHeaders(tok)
        hdr["Content-Type"] = "application/json"
        for _ = 1, 3 do
            local sha, remote
            local okG, res = pcall(http, {Url = GH_API .. "?ref=main", Method = "GET", Headers = hdr})
            if not (okG and res) then return false, "no connection to GitHub (" .. tostring(res):sub(1, 60) .. ")" end
            if res.StatusCode == 200 then
                local okJ, j = pcall(function() return HttpService:JSONDecode(res.Body) end)
                if okJ and type(j) == "table" then
                    sha = j.sha
                    if type(j.content) == "string" and j.content ~= "" then
                        remote = decodeStore(b64dec(j.content))
                    else
                        remote = ghFetchStore()   -- over 1 MB GitHub doesn't inline the content
                    end
                end
            elseif res.StatusCode == 401 then
                return false, "token rejected"
            elseif res.StatusCode ~= 404 then
                return false, "GitHub error " .. ghWhy(res)
            end
            if sha and remote == nil then return false, "couldn't read Egorbuilds!, not overwriting" end
            remote = remote or {}
            local key = name
            for k in pairs(remote) do
                if tostring(k):lower() == name:lower() then key = k end
            end
            remote[key] = value
            local body = HttpService:JSONEncode({message = "Kokuware save " .. name,
                content = b64enc(HttpService:JSONEncode(remote)), sha = sha, branch = "main"})
            local okP, resP = pcall(http, {Url = GH_API, Method = "PUT", Headers = hdr, Body = body})
            if not (okP and resP) then return false, "upload failed to send (" .. tostring(resP):sub(1, 60) .. ")" end
            if resP.StatusCode == 200 or resP.StatusCode == 201 then return true end
            if resP.StatusCode == 401 or resP.StatusCode == 403 or resP.StatusCode == 404 then
                return false, "token can't write to the repo (" .. ghWhy(resP) .. ")"
            end
            task.wait(1.5)   -- 409/422 = someone else just wrote, try again
        end
        return false, "GitHub busy, try again"
    end

    -- !ghtest: is the token valid, and can it write to the repo?
    local function ghTest()
        local http = getHttp()
        if not http then return false, "executor has no http request" end
        local tok = readToken()
        if not tok then return false, "no GitHub token set" end
        local okU, rU = pcall(http, {Url = "https://api.github.com/user", Method = "GET", Headers = ghHeaders(tok)})
        if not (okU and rU) then return false, "can't reach GitHub (" .. tostring(rU):sub(1, 60) .. ")" end
        if rU.StatusCode ~= 200 then return false, "token rejected (" .. ghWhy(rU) .. ")" end
        local login = "?"
        pcall(function() login = HttpService:JSONDecode(rU.Body).login end)
        local okR, rR = pcall(http, {Url = GH_API:gsub("/contents/.*$", ""), Method = "GET", Headers = ghHeaders(tok)})
        if not (okR and rR) then return false, "can't reach the repo" end
        if rR.StatusCode ~= 200 then return false, "token is " .. login .. " but can't see the repo (" .. ghWhy(rR) .. ")" end
        local canPush = false
        pcall(function() canPush = HttpService:JSONDecode(rR.Body).permissions.push == true end)
        if canPush then return true, "token OK (" .. login .. ") and can write to the repo" end
        return false, "token is " .. login .. " but has no write access to the repo"
    end

    local function altSave(rawName)
        local name = cleanName(rawName)
        if name == "" then if isSaver() then say("invalid name") end return end
        local bricks = K.Build.collect("All")          -- EVERYONE's blocks, not just this bot's
        if #bricks == 0 then if isSaver() then say(name .. " nothing to save") end return end
        local okE, json = pcall(K.Build.exportJSON, bricks)
        if not okE or type(json) ~= "string" then if isSaver() then say(name .. " save failed") end return end
        task.wait((mySlot() - 1) * 0.5)                -- bots share the file, so take turns
        local store = readStore()
        local k = findKey(store, name)
        -- slot 1 always replaces the old save; later bots only replace it if they saw MORE blocks
        if k and not isSaver() and type(store[k]) == "string" and #store[k] >= #json then return end
        if k then store[k] = nil end
        store[name] = json
        local localOk = writeStore(store)
        if localOk then addLogEntry("[Save] " .. name .. " (" .. #bricks .. " blocks) -> " .. SAVE_FILE) end
        if not isSaver() then return end
        -- only the saving bot talks to GitHub, so the alts never collide
        local ok, why = ghPush(name, json)
        if ok then
            addLogEntry("[GitHub] " .. name .. " uploaded")
            say(name .. " saved (" .. #bricks .. " blocks) and uploaded to GitHub")
        elseif localOk then
            addLogEntry("[GitHub] upload failed: " .. tostring(why))
            say(name .. " saved on this device only: " .. tostring(why))
        else
            say(name .. " save failed: " .. tostring(why))
        end
    end

    local function altLoad(rawName)
        local name = cleanName(rawName)
        if name == "" then say("invalid name"); return end
        local str, key, from
        local remote = ghFetchStore()                  -- GitHub first, so it works on any device
        if remote then
            local rk = findKey(remote, name)
            if rk and type(remote[rk]) == "string" then str, key, from = remote[rk], rk, "GitHub" end
        end
        if not str then
            str, key = getSaved(name)
            if str then from = "this device" end
        end
        if not str then say(name .. " not found"); return end
        local n, err = K.Build.load(str)
        if not n then say(name .. " load failed"); addLogEntry("[Load] " .. tostring(err)); return end
        K.Build.cf = nil                                -- build back at the saved world position
        loadedName = tostring(key)
        local lk = loadedName:lower()
        loaders[lk] = loaders[lk] or {}
        loaders[lk][LocalPlayer.UserId] = true
        addLogEntry("[Load] " .. loadedName .. " (" .. n .. " blocks) from " .. from)
        say(loadedName .. " loaded")                    -- other bots count this message to split the work
    end

    local function altDelete(rawName)
        local name = cleanName(rawName)
        if name == "" then if isSaver() then say("invalid name") end return end
        task.wait((mySlot() - 1) * 0.5)                -- slot 1 goes first so it can report
        local store = readStore()
        local k = findKey(store, name)
        if k then store[k] = nil; writeStore(store) end
        if loadedName and loadedName:lower() == name:lower() then loadedName = nil end
        if not isSaver() then return end
        local remote = ghFetchStore()
        local rk = remote and findKey(remote, name)
        local pushWhy
        if rk then
            local ok, why = ghPush(rk, nil)
            if not ok then pushWhy = why end
        end
        if pushWhy then
            say(name .. " removed here, but GitHub failed: " .. tostring(pushWhy))
        elseif k or rk then
            addLogEntry("[Save] deleted " .. name)
            say(name .. " deleted!")
        else
            say(name .. " not found")
        end
    end

    -- !loadallsaves: list every save (GitHub first, then anything only on this device)
    local function altList()
        if not isSaver() then return end
        local names, seenN = {}, {}
        local remote = ghFetchStore()
        if remote then
            for k, v in pairs(remote) do
                if type(v) == "string" then names[#names + 1] = tostring(k); seenN[tostring(k):lower()] = true end
            end
        end
        for k, v in pairs(readStore()) do
            if type(v) == "string" and not seenN[tostring(k):lower()] then names[#names + 1] = tostring(k) .. " (device only)" end
        end
        table.sort(names, function(a, b) return a:lower() < b:lower() end)
        if #names == 0 then say(remote and "no saves yet" or "no saves here (couldn't reach GitHub)"); return end
        local lines, cur = {}, ""
        for _, n in ipairs(names) do
            if #cur + #n + 2 > 170 then lines[#lines + 1] = cur; cur = "" end
            cur = cur .. (cur == "" and "" or ", ") .. n
        end
        if cur ~= "" then lines[#lines + 1] = cur end
        say(#names .. " saves" .. (remote and "" or " (GitHub unreachable)") .. ":")
        for _, l in ipairs(lines) do task.wait(1.3); say(l) end
        addLogEntry("[Save] listed " .. #names .. " saves")
    end

    -- which slice of the build is mine: bots are counted from their "<Name> loaded" messages
    local function splitInfo()
        if botOverride and botOverride >= 1 then
            return (mySlot() - 1) % botOverride, botOverride
        end
        local ids, has = {}, {}
        for uid in pairs(loaders[(loadedName or ""):lower()] or {}) do
            if Players:GetPlayerByUserId(uid) then ids[#ids + 1] = uid; has[uid] = true end
        end
        if not has[LocalPlayer.UserId] then ids[#ids + 1] = LocalPlayer.UserId end
        table.sort(ids)
        return (table.find(ids, LocalPlayer.UserId) or 1) - 1, #ids
    end

    local function altAutoStop(silent)
        autoToken += 1
        local was = autoOn
        autoOn = false
        pcall(K.AdvBuild.stop)
        if not silent and was then say("autobuild off") end
    end

    local function altAutoStart()
        if not K.Build.raw then say("first !load a build"); return end
        local AB = K.AdvBuild
        local miss = missingKit()
        if #miss > 0 then say(toolWords(miss) .. " not in inventory") else say("autobuild on") end
        autoToken += 1
        local mine = autoToken
        autoOn = true
        task.spawn(function()
            local warned = #miss > 0
            local slice, started = nil, false
            task.wait(2)   -- let the other bots' "loaded" messages arrive so everyone splits the same way
            while autoOn and mine == autoToken and not _G.KokuwareUnloaded do
                local m = missingKit()
                local hard = false                       -- Shape is only needed for resized blocks
                for _, n in ipairs(m) do if n ~= "Shape" then hard = true end end
                if #m == 3 or hard then
                    if not warned then say(toolWords(m) .. " not in inventory"); warned = true end
                    task.wait(2)
                else
                    if warned then warned = false; say("autobuild on") end
                    if not (AB.running or K.Build.busy) then
                        if not slice then
                            local layout = K.Build.layout()
                            if not layout then say("first !load a build"); return end
                            local idx, cnt = splitInfo()
                            slice = K.Build.share(layout, idx, cnt)
                            addLogEntry(string.format("[AutoBuild] bot %d of %d builds %d of %d blocks", idx + 1, cnt, #slice, #layout))
                        end
                        if not started then
                            started = true
                            AB.run(slice)
                        else
                            local missingBlocks = AB.findMissing(slice)    -- keeps repairing anything removed
                            if #missingBlocks > 0 then AB.run(missingBlocks) end
                        end
                    end
                    task.wait(3)
                end
            end
        end)
    end

    local function handleAltControl(plr, cmd, args)
        if plr == LocalPlayer and not isSolo() then return end
        if cmd == "save" then
            local nm = args:match("^(%S+)")
            if nm then
                pendingSaveUntil = 0
                task.spawn(altSave, nm)
            else
                pendingSaveUntil = os.clock() + 120
                if isSaver() then say("What will you setname?") end
            end
        elseif cmd == "setname" then
            if os.clock() > pendingSaveUntil then return end
            pendingSaveUntil = 0
            task.spawn(altSave, args:match("^(%S+)"))
        elseif cmd == "load" then
            task.spawn(altLoad, args:match("^(%S+)"))
        elseif cmd == "deletesave" then
            task.spawn(altDelete, args:match("^(%S+)"))
        elseif cmd == "delete" then
            local nm = args:match("^[Ss][Aa][Vv][Ee]%s+(%S+)")      -- "!delete save City"
            if nm then task.spawn(altDelete, nm) end
        elseif cmd == "loadallsaves" then
            task.spawn(altList)
        elseif cmd == "ghtest" then
            if isSaver() then
                task.spawn(function()
                    local ok, msg = ghTest()
                    addLogEntry("[GitHub] " .. tostring(msg))
                    say("GitHub: " .. tostring(msg))
                end)
            end
        elseif cmd == "autobuild" then
            local v = args:gsub("^=%s*", ""):lower()
            if v == "true" or v == "on" or v == "1" then altAutoStart()
            elseif v == "false" or v == "off" or v == "0" then altAutoStop(false) end
        end
    end

    local function handleChat(plr, text)
        if type(text) ~= "string" or not plr then return end
        if plr ~= LocalPlayer then
            local ln = text:match("^%s*([%w_%-]+) loaded%s*$")
            if ln then
                local k = ln:lower()
                loaders[k] = loaders[k] or {}
                loaders[k][plr.UserId] = true
            end
        end
        local cmd, args = text:match("^!(%a+)%s*(.-)%s*$")
        if not cmd then return end
        cmd = cmd:lower()
        if cmd ~= "save" and cmd ~= "setname" and cmd ~= "load" and cmd ~= "deletesave" and cmd ~= "delete"
            and cmd ~= "loadallsaves" and cmd ~= "ghtest" and cmd ~= "bots" and cmd ~= "hub"
            and cmd ~= "blacklist" and cmd ~= "unblacklist" and cmd ~= "music" and cmd ~= "stopmusic"
            and not (cmd == "autobuild" and args:match("^%s*=")) then return end
        if not allowed(plr) then return end
        if (cmd == "blacklist" or cmd == "unblacklist") and not isAdmin(plr.Name) then return end
        local key = plr.UserId .. ":" .. text
        local now = os.clock()
        if seen[key] and now - seen[key] < 1.5 then return end
        seen[key] = now
        if cmd == "save" or cmd == "setname" or cmd == "load" or cmd == "autobuild" or cmd == "deletesave"
            or cmd == "delete" or cmd == "loadallsaves" or cmd == "ghtest" then
            handleAltControl(plr, cmd, args)
        elseif cmd == "bots" then
            local n = tonumber(args:match("^(%d+)"))
            if n and n >= 1 then botOverride = n end
        elseif cmd == "blacklist" then
            local ok, msg = blAdd(args, plr.Name)
            addLogEntry("[Blacklist] " .. msg)
        elseif cmd == "unblacklist" then
            blRemove((args or ""):lower(), plr.Name)
            addLogEntry("[Blacklist] removed " .. tostring(args))
        elseif cmd == "hub" then
            if setHubVisible then setHubVisible(not hub.Visible) end
        elseif cmd == "stopmusic" then
            stopMusic()
        elseif cmd == "music" then
            local a = (args or ""):lower()
            if a == "" or a == "off" or a == "stop" then
                stopMusic()
            elseif a:match("^vol%s*%d+$") then
                snd.Volume = math.clamp(tonumber(a:match("%d+")), 0, 10) / 5
            else
                local id = tonumber(a:match("^%d+$"))
                local hit
                for i, s in ipairs(PLAYLIST) do
                    if s.name:lower():gsub("%s", ""):find(a:gsub("%s", ""), 1, true) then hit = i; break end
                end
                if hit then playIndex(hit)
                elseif id then
                    PLAYLIST[#PLAYLIST + 1] = {name = "temp " .. id, id = id, temp = true}
                    playIndex(#PLAYLIST)
                    table.remove(PLAYLIST, #PLAYLIST)
                else
                    addLogEntry("[Music] no track matching '" .. a .. "'")
                end
            end
        end
    end
