local function smooth(b)
    local ov = Instance.new("Frame")
    ov.Name = "Hover"
    ov.Size = UDim2.fromScale(1, 1)
    ov.BackgroundColor3 = WHITE
    ov.BackgroundTransparency = 1
    ov.BorderSizePixel = 0
    ov.ZIndex = b.ZIndex + 1
    ov.Parent = b
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 10)
    c.Parent = ov
    local info = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local function to(t) TweenService:Create(ov, info, {BackgroundTransparency = t}):Play() end
    b.MouseEnter:Connect(function() to(0.92) end)
    b.MouseLeave:Connect(function() to(1) end)
    b.MouseButton1Down:Connect(function() to(0.85) end)
    b.MouseButton1Up:Connect(function() to(UIS.TouchEnabled and 1 or 0.92) end)
end

local function popIn(frame)
