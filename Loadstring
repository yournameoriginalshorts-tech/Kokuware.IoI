do
    local function clean(s)
        return (tostring(s):gsub("^%s+", ""):gsub("%s+$", ""):lower())
    end
    local function norm(list)
        local out = {}
        for _, v in ipairs(type(list) == "table" and list or {}) do
            local n = tonumber(v)
            if n then out[n] = true else out[clean(v)] = true end
        end
        return out
    end
    local function merge(a, b)
        local out = {}
        for k in pairs(a) do out[k] = true end
        for k in pairs(b) do out[k] = true end
        return out
    end
    local function listed(set, player)
        return set[player.UserId] == true or set[clean(player.Name)] == true
    end

    local permSet     = norm(PERM_OWNERS)
    local approvedSet = merge(permSet, norm(WHITELISTED))
    local localBlack  = norm(BLACKLISTED)

    local A = {whitelist = {}, blacklist = localBlack, mode = "open", loaded = false}
    K.Access = A

    function A.isPermOwner(player) return player ~= nil and listed(permSet, player) end
    function A.isApproved(player) return player ~= nil and listed(approvedSet, player) end
    function A.isBlacklisted(player)
        return player ~= nil and not listed(permSet, player) and listed(A.blacklist, player)
    end
    function A.isWhitelisted(player)
        return player ~= nil and (listed(A.whitelist, player) or listed(approvedSet, player))
    end
    function A.canRun(player) return not A.isBlacklisted(player) end

    function A.refresh()
        if ACCESS_URL == "" or ACCESS_URL:find("YOUR_ACCESS", 1, true) then return false end
        local url = ACCESS_URL .. (ACCESS_URL:find("?", 1, true) and "&" or "?") .. "t=" .. os.time()
        local ok, body = pcall(function() return game:HttpGet(url) end)
        if not ok or type(body) ~= "string" then return false end
        local ok2, data = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok2 or type(data) ~= "table" then return false end
        A.blacklist = merge(localBlack, norm(data.blacklist))
        A.whitelist = norm(data.whitelist)
        A.loaded = true
        return true
    end
end

K.Access.refresh()
